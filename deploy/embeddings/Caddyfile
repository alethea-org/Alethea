{
	admin off
	auto_https off
}

:8080 {
	# Health probe for Fly checks: Ollama's root answers "Ollama is running".
	@health {
		method GET HEAD
		path /
	}
	handle @health {
		reverse_proxy 127.0.0.1:11434 {
			# Ollama answers 403 to a non-local Host header.
			header_up Host 127.0.0.1:11434
		}
	}

	# The only API the app uses. The token is substituted at startup and must
	# be a plain value without wildcards (generate it with `openssl rand -hex 32`).
	@embed {
		method POST
		path /api/embed
		header Authorization "Bearer {$OLLAMA_AUTH_TOKEN}"
	}
	handle @embed {
		reverse_proxy 127.0.0.1:11434 {
			header_up Host 127.0.0.1:11434
		}
	}

	handle {
		header Content-Type application/json
		respond `{"error":"unauthorized"}` 401
	}
}
