# ===========================================
# Alethea - Variables de Entorno para Producción
# ===========================================
# Copiar este archivo a .env y completar los valores.
# NUNCA commitear el archivo .env al repositorio.

# ===========================================
# APLICACIÓN
# ===========================================

# Secret key para cookies y sesiones (generar con: mix phx.gen.secret)
SECRET_KEY_BASE=

# Host público para producción
PHX_HOST=tu-dominio.com

# Puerto (para contenedores/Kubernetes)
PORT=4000

# ===========================================
# BASE DE DATOS
# ===========================================

# URL de conexión a PostgreSQL
# Formato: ecto://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Tamaño del pool de conexiones (opcional, default: 10)
# POOL_SIZE=10

# ===========================================
# CIFRADO (CRÍTICO)
# ===========================================

# Clave AES-256 para cifrado de datos clínicos
# Generar con: mix run -e 'IO.puts(Base.encode64(:crypto.strong_rand_bytes(32)))'
CLOAK_AES_KEY=

# Secreto para hashear números de teléfono (mínimo 32 bytes)
# Generar con: mix run -e 'IO.puts(Base.encode64(:crypto.strong_rand_bytes(32)))'
PHONE_HASH_SECRET=

# ===========================================
# WHATSAPP BUSINESS API
# ===========================================

# Token de acceso a la API de WhatsApp Business
WHATSAPP_API_TOKEN=

# ID del número de teléfono de WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=

# App Secret de WhatsApp (para verificar webhooks)
WHATSAPP_APP_SECRET=

# ===========================================
# IA - LLM (Phi-4 u otro)
# ===========================================

# Provider: "local" para Ollama, "cloud" para OpenAI compatible
AI_PROVIDER=local

# Si AI_PROVIDER=local (Ollama):
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama

# Si AI_PROVIDER=cloud:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# ===========================================
# IA - Emotion sidecar
# ===========================================

# Persistent local emotion-only service. It requires no credentials.
EMOTION_SIDECAR_URL=http://127.0.0.1:8080
# EMOTION_SIDECAR_CONNECT_TIMEOUT_MS=2000
# EMOTION_SIDECAR_RECEIVE_TIMEOUT_MS=30000
# EMOTION_SIDECAR_MAX_BATCH_SIZE=32
# EMOTION_SIDECAR_MAX_TEXT_BYTES=4096

# ===========================================
# OPCIONALES
# ===========================================

# Para clustering DNS (opcional)
# DNS_CLUSTER_QUERY=

# Para SSL en producción (opcional)
# SSL_KEY_PATH=/path/to/server.key
# SSL_CERT_PATH=/path/to/server.crt
