<%!--
  Minimal auth layout — no sidebar, no topbar, no app shell.
  Used for login, register, and other unauthenticated pages.
--%>

<style>
  #auth-layout {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 20px 40px;
    background: #f1f5f9;
    background-image:
      radial-gradient(ellipse at 20% 50%, rgba(99, 102, 241, 0.08) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 20%, rgba(139, 92, 246, 0.06) 0%, transparent 55%),
      radial-gradient(ellipse at 60% 80%, rgba(99, 102, 241, 0.05) 0%, transparent 50%);
  }
</style>

<div id="auth-layout">
  <.flash_group flash={@flash} />
  {@inner_content}
</div>
