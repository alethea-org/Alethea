<%!-- PROTOTYPE (#116) — layout variant dispatch.
     Delete this case (keeping the "actual" branch) together with
     AletheaWeb.Components.PagePrototypeVariants. --%>
<div class={["pt-theme", @theme == "warm" && "pt-theme--warm"]}>
  <%= case @prototype_variant do %>
    <% "a" -> %>
      {AletheaWeb.Components.PagePrototypeVariants.variant_a(assigns)}
    <% "b" -> %>
      {AletheaWeb.Components.PagePrototypeVariants.variant_b(assigns)}
    <% "c" -> %>
      {AletheaWeb.Components.PagePrototypeVariants.variant_c(assigns)}
    <% _ -> %>
      <style>
        /* Landing Page Styles - Consistent with auth pages */

        .landing-nav {
          position: fixed;
          top: 0;
          left: 0;
          right: 0;
          z-index: 50;
          background: rgba(255,255,255,0.9);
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
          border-bottom: 1px solid #e8edf5;
        }

        .landing-nav-inner {
          max-width: 1120px;
          margin: 0 auto;
          padding: 0 24px;
          height: 64px;
          display: flex;
          align-items: center;
          justify-content: space-between;
        }

        .landing-logo {
          display: flex;
          align-items: center;
          gap: 10px;
          text-decoration: none;
        }

        .landing-logo-icon {
          width: 36px;
          height: 36px;
          border-radius: 10px;
          background: linear-gradient(135deg, #6366f1, #8b5cf6);
          display: flex;
          align-items: center;
          justify-content: center;
          box-shadow: 0 4px 12px rgba(99,102,241,.3);
        }

        .landing-logo-text {
          font-size: 18px;
          font-weight: 800;
          color: #1e293b;
          letter-spacing: -0.02em;
        }

        .landing-nav-actions {
          display: flex;
          align-items: center;
          gap: 8px;
        }

        .landing-nav-btn {
          padding: 8px 16px;
          border-radius: 9px;
          font-size: 13px;
          font-weight: 600;
          text-decoration: none;
          transition: all .15s ease;
        }

        .landing-nav-btn-ghost {
          color: #64748b;
        }
        .landing-nav-btn-ghost:hover {
          color: #1e293b;
          background: #f1f5f9;
        }

        .landing-nav-btn-primary {
          background: linear-gradient(135deg, #6366f1 0%, #7c3aed 100%);
          color: #fff;
          box-shadow: 0 2px 8px rgba(99,102,241,.3);
        }
        .landing-nav-btn-primary:hover {
          transform: translateY(-1px);
          box-shadow: 0 4px 14px rgba(99,102,241,.4);
        }

        /* Hero Section */
        .landing-hero {
          padding: 140px 24px 80px;
          text-align: center;
          background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        }

        .landing-hero-badge {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          padding: 6px 14px;
          background: #f0fdf4;
          border: 1px solid #bbf7d0;
          border-radius: 100px;
          font-size: 12px;
          font-weight: 600;
          color: #16a34a;
          margin-bottom: 24px;
        }

        .landing-hero-title {
          font-size: clamp(32px, 5vw, 52px);
          font-weight: 800;
          color: #1e293b;
          letter-spacing: -0.03em;
          line-height: 1.1;
          margin-bottom: 20px;
          max-width: 700px;
          margin-left: auto;
          margin-right: auto;
        }

        .landing-hero-title span {
          background: linear-gradient(135deg, #6366f1, #8b5cf6);
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
        }

        .landing-hero-subtitle {
          font-size: 18px;
          color: #64748b;
          line-height: 1.6;
          max-width: 560px;
          margin: 0 auto 36px;
        }

        .landing-hero-actions {
          display: flex;
          flex-direction: column;
          sm:flex-row;
          gap: 12px;
          justify-content: center;
        }

        .landing-btn {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 8px;
          padding: 14px 28px;
          border-radius: 12px;
          font-size: 15px;
          font-weight: 700;
          text-decoration: none;
          transition: all .15s ease;
          letter-spacing: 0.01em;
        }

        .landing-btn-primary {
          background: linear-gradient(135deg, #6366f1 0%, #7c3aed 100%);
          color: #fff;
          box-shadow: 0 4px 16px rgba(99,102,241,.4);
        }
        .landing-btn-primary:hover {
          transform: translateY(-2px);
          box-shadow: 0 8px 24px rgba(99,102,241,.5);
        }

        .landing-btn-outline {
          background: #fff;
          color: #1e293b;
          border: 1.5px solid #e2e8f0;
          box-shadow: 0 2px 8px rgba(0,0,0,.04);
        }
        .landing-btn-outline:hover {
          border-color: #6366f1;
          color: #6366f1;
        }

        /* Features Section */
        .landing-features {
          padding: 80px 24px;
          max-width: 1120px;
          margin: 0 auto;
        }

        .landing-section-label {
          text-align: center;
          font-size: 11px;
          font-weight: 700;
          color: #6366f1;
          text-transform: uppercase;
          letter-spacing: 0.1em;
          margin-bottom: 12px;
        }

        .landing-section-title {
          text-align: center;
          font-size: 28px;
          font-weight: 800;
          color: #1e293b;
          letter-spacing: -0.02em;
          margin-bottom: 48px;
        }

        .landing-features-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
          gap: 24px;
        }

        .landing-feature-card {
          background: #fff;
          border-radius: 16px;
          padding: 28px;
          border: 1px solid #e8edf5;
          box-shadow: 0 1px 3px rgba(0,0,0,.02), 0 4px 12px rgba(0,0,0,.04);
          transition: all .2s ease;
        }
        .landing-feature-card:hover {
          transform: translateY(-4px);
          box-shadow: 0 8px 30px rgba(99,102,241,.12);
          border-color: #6366f1;
        }

        .landing-feature-icon {
          width: 48px;
          height: 48px;
          border-radius: 12px;
          display: flex;
          align-items: center;
          justify-content: center;
          margin-bottom: 18px;
        }

        .landing-feature-icon-purple { background: linear-gradient(135deg, #6366f1, #8b5cf6); }
        .landing-feature-icon-green { background: linear-gradient(135deg, #16a34a, #22c55e); }
        .landing-feature-icon-blue { background: linear-gradient(135deg, #0ea5e9, #38bdf8); }

        .landing-feature-title {
          font-size: 17px;
          font-weight: 700;
          color: #1e293b;
          margin-bottom: 10px;
          letter-spacing: -0.01em;
        }

        .landing-feature-desc {
          font-size: 14px;
          color: #64748b;
          line-height: 1.6;
        }

        /* CTA Section */
        .landing-cta {
          padding: 80px 24px;
          text-align: center;
          background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
        }

        .landing-cta-title {
          font-size: 28px;
          font-weight: 800;
          color: #fff;
          letter-spacing: -0.02em;
          margin-bottom: 16px;
        }

        .landing-cta-subtitle {
          font-size: 16px;
          color: #c7d2fe;
          margin-bottom: 32px;
          max-width: 500px;
          margin-left: auto;
          margin-right: auto;
        }

        .landing-cta-btn {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          padding: 14px 28px;
          background: #fff;
          color: #1e293b;
          border-radius: 12px;
          font-size: 15px;
          font-weight: 700;
          text-decoration: none;
          transition: all .15s ease;
          box-shadow: 0 4px 16px rgba(0,0,0,.2);
        }
        .landing-cta-btn:hover {
          transform: translateY(-2px);
          box-shadow: 0 8px 24px rgba(0,0,0,.3);
        }

        /* Footer */
        .landing-footer {
          padding: 32px 24px;
          text-align: center;
          border-top: 1px solid #e8edf5;
          background: #fff;
        }

        .landing-footer-text {
          font-size: 13px;
          color: #94a3b8;
        }
      </style>

      <%!-- Navbar --%>
      <nav class="landing-nav">
        <div class="landing-nav-inner">
          <.link navigate={~p"/"} class="landing-logo">
            <div class="landing-logo-icon">
              <img
                src={~p"/images/logo.svg"}
                alt=""
                width="20"
                style="filter:brightness(0) invert(1);"
              />
            </div>
            <span class="landing-logo-text">Alethea</span>
          </.link>

          <div class="landing-nav-actions">
            <.link navigate={~p"/login"} class="landing-nav-btn landing-nav-btn-ghost">
              Iniciar sesión
            </.link>
            <.link navigate={~p"/register"} class="landing-nav-btn landing-nav-btn-primary">
              Comenzar
            </.link>
          </div>
        </div>
      </nav>

      <%!-- Hero --%>
      <section class="landing-hero">
        <div class="landing-hero-badge">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          </svg>
          Privacidad primero
        </div>

        <h1 class="landing-hero-title">
          Diario clínico inteligente<br /> para <span>psicólogos</span>
        </h1>

        <p class="landing-hero-subtitle">
          Acompañamiento 24/7 para tus pacientes vía WhatsApp, con análisis emocional por IA y resúmenes semanales que facilitan tu trabajo clínico.
        </p>

        <div class="landing-hero-actions">
          <.link navigate={~p"/register"} class="landing-btn landing-btn-primary">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
            Crear cuenta gratis
          </.link>
          <.link navigate={~p"/login"} class="landing-btn landing-btn-outline">
            Ya tengo cuenta
          </.link>
        </div>
      </section>

      <%!-- Features --%>
      <section class="landing-features">
        <p class="landing-section-label">Características</p>
        <h2 class="landing-section-title">Todo lo que necesitás para tu práctica</h2>

        <div class="landing-features-grid">
          <div class="landing-feature-card">
            <div class="landing-feature-icon landing-feature-icon-purple">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
            </div>
            <h3 class="landing-feature-title">Cifrado de extremo a extremo</h3>
            <p class="landing-feature-desc">
              Cada paciente tiene sus datos cifrados con claves únicas. Solo vos y tu paciente acceden a su información.
            </p>
          </div>

          <div class="landing-feature-card">
            <div class="landing-feature-icon landing-feature-icon-green">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
              </svg>
            </div>
            <h3 class="landing-feature-title">Journaling vía WhatsApp</h3>
            <p class="landing-feature-desc">
              Tus pacientes escriben cuando quieran desde WhatsApp. Sin apps, sin passwords, sin fricción.
            </p>
          </div>

          <div class="landing-feature-card">
            <div class="landing-feature-icon landing-feature-icon-blue">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 20V10M12 20V4M6 20v-6" />
              </svg>
            </div>
            <h3 class="landing-feature-title">Análisis emocional con IA</h3>
            <p class="landing-feature-desc">
              RoBERTa detecta patrones emocionales y grafos de conducta. Detectá crisis antes de que ocurran.
            </p>
          </div>

          <div class="landing-feature-card">
            <div class="landing-feature-icon landing-feature-icon-purple">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
            </div>
            <h3 class="landing-feature-title">Resúmenes semanales</h3>
            <p class="landing-feature-desc">
              Cada semana recibís un resumen estructurado de la evolución de cada paciente. Listo para tu sesión.
            </p>
          </div>

          <div class="landing-feature-card">
            <div class="landing-feature-icon landing-feature-icon-green">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                <line x1="12" y1="9" x2="12" y2="13" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
              </svg>
            </div>
            <h3 class="landing-feature-title">Detección de crisis</h3>
            <p class="landing-feature-desc">
              Alertas automáticas cuando el sistema detecta señales de riesgo. Intervención rápida cuando más importa.
            </p>
          </div>

          <div class="landing-feature-card">
            <div class="landing-feature-icon landing-feature-icon-blue">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
            </div>
            <h3 class="landing-feature-title">Dashboard clínico</h3>
            <p class="landing-feature-desc">
              Visualizá el progreso de todos tus pacientes en un solo lugar. Accedé desde cualquier dispositivo.
            </p>
          </div>
        </div>
      </section>

      <%!-- CTA --%>
      <section class="landing-cta">
        <h2 class="landing-cta-title">Empezá hoy, sin costo</h2>
        <p class="landing-cta-subtitle">
          Registrate y empezá a usar Alethea con tus primeros pacientes. Sin compromisos, sin tarjeta de crédito.
        </p>
        <.link navigate={~p"/register"} class="landing-cta-btn">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
          Crear mi cuenta
        </.link>
      </section>

      <%!-- Footer --%>
      <footer class="landing-footer">
        <p class="landing-footer-text">
          Alethea — Centro de Control Clínico · Cifrado de extremo a extremo
        </p>
      </footer>
  <% end %>
</div>

<%!-- PROTOTYPE (#116) — delete with AletheaWeb.Components.PrototypeSwitcher. --%>
<AletheaWeb.Components.PrototypeSwitcher.prototype_switcher
  base_path="/"
  theme={@theme}
  current={@prototype_variant}
  variants={[
    {"actual", "Actual"},
    {"a", "Editorial — dos columnas"},
    {"b", "Producto — el panel como héroe"},
    {"c", "Una pantalla — oscuro, 3 pasos"}
  ]}
/>
