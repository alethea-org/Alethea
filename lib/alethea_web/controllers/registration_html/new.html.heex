<%!--
  Registration page — rendered inside auth.html.heex.
  @changeset always assigned by RegistrationController.
--%>
<style>
  .auth-card { width: 100%; max-width: 400px; }

  .auth-logo {
    width: 52px; height: 52px; border-radius: 14px;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 24px rgba(99,102,241,.35);
    margin: 0 auto 14px;
  }

  .auth-card-inner {
    background: #ffffff; border-radius: 20px; padding: 32px;
    box-shadow:
      0 1px 3px rgba(0,0,0,.04),
      0 4px 16px rgba(0,0,0,.06),
      0 12px 40px rgba(99,102,241,.06);
    border: 1px solid #e8edf5;
  }

  .auth-label {
    display: block; font-size: 11px; font-weight: 700; color: #64748b;
    text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 7px;
  }

  .auth-input-wrap { position: relative; }
  .auth-input-icon {
    position: absolute; left: 13px; top: 50%; transform: translateY(-50%);
    color: #94a3b8; pointer-events: none;
  }

  .auth-input {
    width: 100%; padding: 12px 14px 12px 40px;
    border: 1.5px solid #e2e8f0; border-radius: 11px;
    font-size: 14px; color: #1e293b; background: #fff;
    outline: none; font-family: inherit;
    transition: border-color .15s ease, box-shadow .15s ease;
    -webkit-appearance: none;
  }
  .auth-input:-webkit-autofill,
  .auth-input:-webkit-autofill:hover,
  .auth-input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px #fff inset !important;
    -webkit-text-fill-color: #1e293b !important;
    border-color: #e2e8f0 !important;
    transition: background-color 5000s ease-in-out 0s;
  }
  .auth-input:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99,102,241,.1);
  }
  .auth-input--error { border-color: #fca5a5 !important; }
  .auth-input--error:focus {
    border-color: #ef4444 !important;
    box-shadow: 0 0 0 3px rgba(239,68,68,.1) !important;
  }

  .auth-field-err {
    margin-top: 5px; font-size: 11px; color: #ef4444;
    display: flex; align-items: center; gap: 4px; line-height: 1.3;
  }

  .auth-hint {
    margin-top: 5px; font-size: 11px; color: #94a3b8; line-height: 1.4;
  }

  .auth-btn {
    width: 100%; padding: 13px;
    background: linear-gradient(135deg, #6366f1 0%, #7c3aed 100%);
    color: #fff; font-size: 14px; font-weight: 700;
    border: none; border-radius: 11px; cursor: pointer;
    box-shadow: 0 4px 14px rgba(99,102,241,.45);
    transition: transform .15s ease, box-shadow .15s ease, opacity .1s;
    letter-spacing: 0.015em; font-family: inherit;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .auth-btn:hover { transform: translateY(-1px); box-shadow: 0 7px 20px rgba(99,102,241,.5); }
  .auth-btn:active { transform: translateY(0); box-shadow: 0 2px 8px rgba(99,102,241,.4); }

  .auth-footer-link {
    text-align: center; margin-top: 20px; font-size: 13px; color: #64748b;
  }
  .auth-footer-link a {
    color: #6366f1; font-weight: 700; text-decoration: none;
  }
  .auth-footer-link a:hover { color: #4f46e5; text-decoration: underline; }

  .auth-security-note {
    text-align: center; margin-top: 14px; font-size: 11px; color: #94a3b8;
    display: flex; align-items: center; justify-content: center; gap: 5px;
  }
</style>

<div class="auth-card">
  <%!-- Brand --%>
  <div style="text-align:center; margin-bottom:24px;">
    <div class="auth-logo">
      <img
        src={~p"/images/logo.svg"}
        alt="Alethea"
        width="24"
        style="filter:brightness(0) invert(1);"
      />
    </div>

    <h1 style="font-size:22px; font-weight:800; color:#1e293b; letter-spacing:-0.03em; margin-bottom:2px;">
      Alethea
    </h1>

    <p style="font-size:11px; color:#94a3b8; font-weight:600; text-transform:uppercase; letter-spacing:0.09em;">
      Centro de Control Clínico
    </p>
  </div>
  <%!-- Card --%>
  <div class="auth-card-inner">
    <div style="display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:20px;background:#eef2ff;color:#6366f1;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:14px;">
      <svg
        width="10"
        height="10"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /> <circle cx="9" cy="7" r="4" />
        <line x1="19" y1="8" x2="19" y2="14" /> <line x1="22" y1="11" x2="16" y2="11" />
      </svg>
      Cuenta profesional
    </div>

    <h2 style="font-size:17px; font-weight:800; color:#1e293b; letter-spacing:-0.02em; margin-bottom:4px;">
      Crear tu cuenta
    </h2>

    <p style="font-size:13px; color:#94a3b8; margin-bottom:24px;">
      Completá los datos para acceder a Alethea
    </p>

    <form action="/register" method="post" id="registration-form">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} /> <%!-- Full name --%>
      <div style="margin-bottom:16px;">
        <label for="reg-full-name" class="auth-label">Nombre completo</label>
        <div class="auth-input-wrap">
          <svg
            class="auth-input-icon"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /> <circle cx="12" cy="7" r="4" />
          </svg>
          <input
            type="text"
            name="professional[full_name]"
            id="reg-full-name"
            required
            placeholder="Lic. Nombre Apellido"
            autocomplete="name"
            value={Ecto.Changeset.get_field(@changeset, :full_name) || ""}
            class={[
              "auth-input",
              Keyword.has_key?(@changeset.errors, :full_name) && "auth-input--error"
            ]}
          />
        </div>

        <%= for {msg, _} <- Keyword.get_values(@changeset.errors, :full_name) do %>
          <p class="auth-field-err">
            <svg
              width="10"
              height="10"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10" /> <line x1="12" y1="8" x2="12" y2="12" />
              <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            {msg}
          </p>
        <% end %>
      </div>
      <%!-- Email --%>
      <div style="margin-bottom:16px;">
        <label for="reg-email" class="auth-label">Correo electrónico</label>
        <div class="auth-input-wrap">
          <svg
            class="auth-input-icon"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
            <polyline points="22,6 12,13 2,6" />
          </svg>
          <input
            type="email"
            name="professional[email]"
            id="reg-email"
            required
            placeholder="tu@email.com"
            autocomplete="email"
            value={Ecto.Changeset.get_field(@changeset, :email) || ""}
            class={[
              "auth-input",
              Keyword.has_key?(@changeset.errors, :email) && "auth-input--error"
            ]}
          />
        </div>

        <%= for {msg, _} <- Keyword.get_values(@changeset.errors, :email) do %>
          <p class="auth-field-err">
            <svg
              width="10"
              height="10"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10" /> <line x1="12" y1="8" x2="12" y2="12" />
              <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            {msg}
          </p>
        <% end %>
      </div>
      <%!-- Password --%>
      <div style="margin-bottom:24px;">
        <label for="reg-password" class="auth-label">Contraseña</label>
        <div class="auth-input-wrap">
          <svg
            class="auth-input-icon"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
          <input
            type="password"
            name="professional[password]"
            id="reg-password"
            required
            placeholder="••••••••"
            autocomplete="new-password"
            class={[
              "auth-input",
              Keyword.has_key?(@changeset.errors, :password) && "auth-input--error"
            ]}
          />
        </div>

        <%= for {msg, _} <- Keyword.get_values(@changeset.errors, :password) do %>
          <p class="auth-field-err">
            <svg
              width="10"
              height="10"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10" /> <line x1="12" y1="8" x2="12" y2="12" />
              <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            {msg}
          </p>
        <% end %>

        <%= if @changeset.errors[:password] == nil do %>
          <p class="auth-hint">Mínimo 12 caracteres</p>
        <% end %>
      </div>

      <button type="submit" id="register-submit-btn" class="auth-btn">
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /> <circle cx="9" cy="7" r="4" />
          <line x1="19" y1="8" x2="19" y2="14" /> <line x1="22" y1="11" x2="16" y2="11" />
        </svg>
        Crear cuenta
      </button>
    </form>
  </div>

  <p class="auth-footer-link">¿Ya tenés cuenta? <a href="/login">Iniciá sesión</a></p>

  <p class="auth-security-note">
    <svg
      width="11"
      height="11"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
      <path d="M7 11V7a5 5 0 0 1 10 0v4" />
    </svg>
    Cifrado de extremo a extremo
  </p>
</div>
