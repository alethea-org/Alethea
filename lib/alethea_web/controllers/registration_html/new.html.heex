<%!--
  Registration page — rendered inside `auth.html.heex`, which
  provides the two-column `#auth-layout` grid. `@changeset` is always
  assigned by `RegistrationController`.

  All appearance comes from the editorial classes; the page carries
  no <style> block and no inline color.
--%>
<section class="auth-panel">
  <.link navigate={~p"/"} class="auth-panel__brand">
    <span class="auth-panel__mark"><img src={~p"/images/logo.svg"} alt="" width="18" /></span>
    Alethea
  </.link>
  <div>
    <h2 class="auth-panel__title">Una cuenta, todo el seguimiento.</h2>

    <p class="auth-panel__lede">
      Invitás al paciente por Telegram, la conversación se cifra con su propia
      clave y vos leés el resumen semanal antes de la sesión.
    </p>
  </div>

  <p class="auth-panel__proof">
    El borrado de datos es criptográfico: se destruye la clave del paciente en
    la bóveda, no se borran filas.
  </p>
</section>

<section class="auth-form-side">
  <div class="auth-form">
    <p class="pt-eyebrow">Cuenta profesional</p>

    <h1 class="auth-form__title">Crear tu cuenta</h1>

    <p class="auth-form__sub">Completá los datos para acceder a Alethea.</p>

    <form action={~p"/register"} method="post" id="registration-form">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <div class="field">
        <label for="reg-full-name" class="field__label">Nombre completo</label>
        <input
          type="text"
          name="professional[full_name]"
          id="reg-full-name"
          required
          placeholder="Lic. Nombre Apellido"
          autocomplete="name"
          value={Ecto.Changeset.get_field(@changeset, :full_name) || ""}
          class={[
            "text-input",
            Keyword.has_key?(@changeset.errors, :full_name) && "text-input--error"
          ]}
        />
        <p
          :for={{msg, _} <- Keyword.get_values(@changeset.errors, :full_name)}
          class="field__error"
        >
          <.icon name="hero-exclamation-circle" class="size-3" />{msg}
        </p>
      </div>

      <div class="field">
        <label for="reg-email" class="field__label">Correo electrónico</label>
        <input
          type="email"
          name="professional[email]"
          id="reg-email"
          required
          placeholder="tu@email.com"
          autocomplete="email"
          value={Ecto.Changeset.get_field(@changeset, :email) || ""}
          class={[
            "text-input",
            Keyword.has_key?(@changeset.errors, :email) && "text-input--error"
          ]}
        />
        <p :for={{msg, _} <- Keyword.get_values(@changeset.errors, :email)} class="field__error">
          <.icon name="hero-exclamation-circle" class="size-3" />{msg}
        </p>
      </div>

      <div class="field">
        <label for="reg-password" class="field__label">Contraseña</label>
        <input
          type="password"
          name="professional[password]"
          id="reg-password"
          required
          placeholder="••••••••"
          autocomplete="new-password"
          class={[
            "text-input",
            Keyword.has_key?(@changeset.errors, :password) && "text-input--error"
          ]}
        />
        <p
          :for={{msg, _} <- Keyword.get_values(@changeset.errors, :password)}
          class="field__error"
        >
          <.icon name="hero-exclamation-circle" class="size-3" />{msg}
        </p>

        <p :if={@changeset.errors[:password] == nil} class="field__hint">Mínimo 12 caracteres</p>
      </div>

      <button
        type="submit"
        id="register-submit-btn"
        class="button-primary button-primary--block"
      >
        Crear cuenta
      </button>
    </form>

    <p class="auth-form__foot">
      ¿Ya tenés cuenta? <.link navigate={~p"/login"}>Iniciá sesión</.link>
    </p>

    <p class="auth-form__note">
      <.icon name="hero-lock-closed" class="size-3" /> Cifrado a nivel de paciente
    </p>
  </div>
</section>
