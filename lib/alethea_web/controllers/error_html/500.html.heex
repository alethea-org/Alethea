<%!--
  500 — rendered with `layout: false` (see `config/config.exs`), so
  the template is a complete document. Same editorial shell as the
  404 page; only the copy changes.
--%>
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Error del servidor · Alethea</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/css/app.css" />
    <link rel="stylesheet" href="/assets/css/editorial.css" />
  </head>

  <body>
    <main class="ptl">
      <div class="ptl-shell error-page">
        <p class="pt-eyebrow">Error 500</p>

        <h1 class="ptla-title">Algo se rompió de nuestro lado.</h1>

        <p class="ptla-lede">El incidente quedó registrado. Ningún dato clínico se expone ante un
          error: el contenido sigue cifrado con la clave del paciente.</p>

        <div class="ptla-actions"><a href="/" class="button-primary">Volver al inicio</a></div>
      </div>
    </main>
  </body>
</html>
