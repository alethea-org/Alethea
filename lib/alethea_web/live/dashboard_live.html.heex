<% patients = assigns[:patients] || []
critical_patients = assigns[:critical_patients] || []
selected_patient = assigns[:selected_patient]
weekly_summary = assigns[:weekly_summary]
session_summaries = assigns[:session_summaries] || []
emotion_rows = assigns[:emotion_rows] || []

mood_signal =
  assigns[:mood_signal] ||
    %{
      label: "Sin datos",
      dot_class: "bg-base-300",
      ring_class: "ring-base-300",
      badge_class: "badge-ghost"
    } %>
<div class="space-y-6">
  <header class="flex flex-col gap-3 border-b border-base-300 pb-5 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-sm font-medium text-base-content/60">Alethea</p>
      <h1 class="text-3xl font-semibold tracking-normal text-base-content">
        Centro de Control
      </h1>
      <p class="mt-1 text-sm text-base-content/70">
        {(@current_professional && @current_professional.full_name) || "Profesional clinico"}
      </p>
    </div>

    <div class="stats stats-horizontal border border-base-300 bg-base-100 shadow-none">
      <div class="stat px-5 py-3">
        <div class="stat-title text-xs">Pacientes</div>
        <div class="stat-value text-2xl">{length(patients)}</div>
      </div>
      <div class="stat px-5 py-3">
        <div class="stat-title text-xs">Alertas</div>
        <div class="stat-value text-2xl text-error">{length(critical_patients)}</div>
      </div>
    </div>
  </header>

  <div class="grid gap-6 lg:grid-cols-[20rem_minmax(0,1fr)]">
    <aside class="space-y-4">
      <section class="rounded-lg border border-error/30 bg-error/5">
        <div class="flex items-center gap-2 border-b border-error/20 px-4 py-3">
          <.icon name="hero-exclamation-triangle" class="size-5 text-error" />
          <h2 class="text-sm font-semibold text-error">Alertas criticas</h2>
        </div>

        <div id="critical-patient-list" class="divide-y divide-error/10">
          <div :if={critical_patients == []} class="px-4 py-5 text-sm text-base-content/60">
            Sin alertas activas.
          </div>

          <.link
            :for={patient <- critical_patients}
            patch={~p"/dashboard/patients/#{patient.id}"}
            id={"critical-patient-#{patient.id}"}
            class="block px-4 py-3 transition hover:bg-error/10"
          >
            <div class="flex items-center justify-between gap-3">
              <div>
                <p class="font-medium text-base-content">{patient.alias}</p>
                <p class="text-xs text-base-content/60">Intervencion prioritaria</p>
              </div>
              <span class="badge badge-error badge-sm">Riesgo</span>
            </div>
          </.link>
        </div>
      </section>

      <section class="rounded-lg border border-base-300 bg-base-100">
        <div class="flex items-center gap-2 border-b border-base-300 px-4 py-3">
          <.icon name="hero-users" class="size-5 text-base-content/70" />
          <h2 class="text-sm font-semibold">Pacientes</h2>
        </div>

        <nav id="dashboard-patient-list" class="divide-y divide-base-300">
          <div :if={patients == []} class="px-4 py-5 text-sm text-base-content/60">
            No hay pacientes para mostrar.
          </div>

          <.link
            :for={patient <- patients}
            patch={~p"/dashboard/patients/#{patient.id}"}
            id={"dashboard-patient-#{patient.id}"}
            class={[
              "block px-4 py-3 transition hover:bg-base-200",
              selected_patient && selected_patient.id == patient.id && "bg-base-200"
            ]}
          >
            <div class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <p class="truncate font-medium text-base-content">{patient.alias}</p>
                <p class="text-xs text-base-content/60">
                  Sesion: {format_session_day(Map.get(patient, :session_day_of_week))} / {format_session_time(
                    Map.get(patient, :session_time)
                  )}
                </p>
              </div>
              <span
                :if={patient.urgent_intervention}
                class="size-2.5 shrink-0 rounded-full bg-error"
              />
            </div>
          </.link>
        </nav>
      </section>
    </aside>

    <main class="min-w-0 space-y-4">
      <section
        :if={selected_patient}
        id="dashboard-patient-detail"
        class="rounded-lg border border-base-300 bg-base-100"
      >
        <div class="flex flex-col gap-4 border-b border-base-300 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-3">
            <span class={[
              "size-4 rounded-full ring-4 motion-safe:animate-pulse",
              mood_signal.dot_class,
              mood_signal.ring_class
            ]} />
            <div>
              <h2 class="text-xl font-semibold text-base-content">{selected_patient.alias}</h2>
              <p class="text-sm text-base-content/60">Detalle clinico activo</p>
            </div>
          </div>

          <span class={["badge", mood_signal.badge_class]}>{mood_signal.label}</span>
        </div>

        <div class="grid gap-4 p-5 xl:grid-cols-[minmax(0,1fr)_18rem]">
          <div class="space-y-4">
            <section
              id="weekly-pre-session-report"
              class="rounded-lg border border-success/20 bg-success/5 p-5"
            >
              <div class="mb-3 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <.icon name="hero-clipboard-document-check" class="size-5 text-success" />
                  <h3 class="text-sm font-bold uppercase tracking-wider text-success">
                    Weekly Pre-Session Report
                  </h3>
                </div>
                <span :if={weekly_summary} class="text-xs text-base-content/50">
                  Finalizado el {format_summary_date(weekly_summary.period_end)}
                </span>
              </div>

              <div :if={weekly_summary} class="prose prose-sm max-w-none text-base-content/80">
                {weekly_summary.summary_text}
              </div>
              <p :if={!weekly_summary} class="text-sm italic text-base-content/50">
                No hay reportes semanales generados para este paciente.
              </p>
            </section>

            <section id="emotion-trends" class="rounded-lg border border-base-300 p-5">
              <div class="mb-5 flex items-center justify-between gap-3">
                <h3 class="font-bold text-base-content">Tendencias del Estado de Ánimo</h3>
                <div class="badge badge-ghost badge-sm font-normal">Últimos 7 días</div>
              </div>

              <div class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
                <div :if={emotion_rows == []} class="col-span-full py-4 text-center text-sm text-base-content/50">
                  Esperando datos de la próxima sincronización...
                </div>

                <div :for={emotion <- emotion_rows} id={"emotion-row-#{emotion.key}"} class="space-y-1.5">
                  <div class="flex items-center justify-between text-xs font-semibold uppercase tracking-tight">
                    <span class="text-base-content/70">{emotion.label}</span>
                    <span class="tabular-nums text-base-content">{emotion.percent}%</span>
                  </div>
                  <progress
                    class={["progress h-2 w-full", emotion.progress_class]}
                    value={emotion.percent}
                    max="100"
                  >
                    {emotion.percent}%
                  </progress>
                </div>
              </div>
            </section>

            <section id="session-snapshots" class="space-y-3">
              <div class="flex items-center gap-2">
                <.icon name="hero-clock" class="size-5 text-base-content/60" />
                <h3 class="font-bold text-base-content">Session Snapshots Históricos</h3>
              </div>

              <div
                :if={session_summaries == []}
                class="rounded-lg border border-dashed border-base-300 p-8 text-center text-sm text-base-content/50"
              >
                Aún no se han completado sesiones con seguimiento clínico.
              </div>

              <div class="space-y-2">
                <details
                  :for={summary <- session_summaries}
                  id={"session-summary-#{summary.id}"}
                  class="group collapse collapse-arrow border border-base-300 bg-base-100 transition-all hover:border-base-content/20"
                >
                  <summary class="collapse-title min-h-0 py-3 text-sm font-medium">
                    <div class="flex items-center gap-3">
                      <span class={[
                        "badge badge-sm uppercase font-bold",
                        summary.status_level == "Estable" && "badge-success",
                        summary.status_level == "Alerta" && "badge-warning",
                        summary.status_level == "Crítico" && "badge-error"
                      ]}>
                        {summary.status_level}
                      </span>
                      <span class="text-base-content/60">
                        Sesión del {format_summary_date(summary.period_end)}
                      </span>
                    </div>
                  </summary>
                  <div class="collapse-content border-t border-base-300 pt-3 text-sm leading-relaxed text-base-content/75">
                    {summary.summary_text}
                  </div>
                </details>
              </div>
            </section>
          </div>

          <aside class="space-y-4">
            <section class="rounded-lg border border-base-300 p-4">
              <h3 class="mb-3 font-semibold">Horario de sesion</h3>
              
              <.form
                for={%{}}
                id="schedule-form"
                phx-submit="save_session_schedule"
                class="space-y-3"
              >
                <div class="form-control">
                  <label class="label py-1">
                    <span class="label-text-alt font-medium">Dia de semana</span>
                  </label>
                  <select name="day" class="select select-bordered select-sm w-full">
                    <option value="1" selected={selected_patient.session_day_of_week == 1}>Lunes</option>
                    <option value="2" selected={selected_patient.session_day_of_week == 2}>Martes</option>
                    <option value="3" selected={selected_patient.session_day_of_week == 3}>Miercoles</option>
                    <option value="4" selected={selected_patient.session_day_of_week == 4}>Jueves</option>
                    <option value="5" selected={selected_patient.session_day_of_week == 5}>Viernes</option>
                    <option value="6" selected={selected_patient.session_day_of_week == 6}>Sabado</option>
                    <option value="7" selected={selected_patient.session_day_of_week == 7}>Domingo</option>
                  </select>
                </div>

                <div class="form-control">
                  <label class="label py-1">
                    <span class="label-text-alt font-medium">Hora</span>
                  </label>
                  <input 
                    type="time" 
                    name="time" 
                    value={format_session_time(selected_patient.session_time)} 
                    class="input input-bordered input-sm w-full" 
                  />
                </div>

                <button type="submit" class="btn btn-ghost btn-sm btn-block border-base-300">
                  Guardar cambios
                </button>
              </.form>
            </section>

            <section class="rounded-lg border border-base-300 p-4">
              <h3 class="mb-3 font-semibold">Configuración de Crisis</h3>
              <p class="mb-3 text-[10px] text-base-content/60 leading-tight">
                Este mensaje se enviará automáticamente si la IA detecta riesgo inminente.
              </p>
              
              <.form
                for={%{}}
                id="crisis-message-form"
                phx-submit="save_crisis_message"
                class="space-y-3"
              >
                <div class="form-control">
                  <textarea 
                    name="crisis_message" 
                    class="textarea textarea-bordered textarea-sm w-full leading-snug" 
                    placeholder="Ej: Entiendo que estás pasando por un momento difícil. Por favor, llama al 911 o a tu servicio de emergencia local..."
                  >{@current_professional.crisis_message}</textarea>
                </div>

                <button type="submit" class="btn btn-ghost btn-sm btn-block border-base-300">
                  Actualizar mensaje
                </button>
              </.form>
            </section>

            <section class="rounded-lg border border-base-300 p-4">
              <h3 class="mb-3 font-semibold">Historial clinico</h3>
              <button
                id="decrypt-chat-button"
                type="button"
                phx-click="decrypt_chat"
                class="btn btn-primary w-full"
              >
                <.icon name="hero-lock-open" class="size-5" /> Descifrar chat
              </button>

              <div 
                :if={@chat_decrypted}
                id="chat-history-modal"
                class="mt-4 max-h-[400px] overflow-y-auto rounded-md border border-base-300 bg-base-200/50 p-3"
                phx-update="stream"
              >
                <div 
                  :for={{id, msg} <- @streams.decrypted_messages} 
                  id={id}
                  class={["chat", msg.direction == "inbound" && "chat-start", msg.direction == "outbound" && "chat-end"]}
                >
                  <div class="chat-header opacity-50 text-[10px]">
                    {Calendar.strftime(msg.timestamp, "%H:%M")}
                  </div>
                  <div class={["chat-bubble text-xs", msg.direction == "outbound" && "chat-bubble-primary"]}>
                    {msg.encrypted_content}
                  </div>
                </div>
              </div>
            </section>
          </aside>
        </div>
      </section>

      <section
        :if={!selected_patient}
        id="dashboard-empty-state"
        class="rounded-lg border border-dashed border-base-300 bg-base-100 p-10 text-center"
      >
        <.icon name="hero-user-circle" class="mx-auto size-10 text-base-content/40" />
        <h2 class="mt-3 text-lg font-semibold">Selecciona un paciente</h2>
        <p class="mt-1 text-sm text-base-content/60">
          El detalle clinico aparecera en este panel.
        </p>
      </section>
    </main>
  </div>
</div>
