<%!-- ═══════════════════════════════════════════════════════════
     Alethea · Dashboard — Editorial briefing layout (#116 → #120)

     The editorial design that won the #116 prototype exploration
     (variant D — switchable patient picker over the briefing column,
     editorial theme from #119). The structural change:

       • Header: eyebrow + display h1 + notification center.
       • Picker: chip rail OR week agenda, toggled by `<.link>` patches
         that carry `?picker=chips|week`.
       • Briefing: one reading column with the weekly pre-session
         report (with the four-tile metric strip from #115), the
         emotion trends and the 7-day daily chart, the session
         snapshots, the schedule form, the chat-decrypt control.
       • Settings: collapsed at the bottom — crisis containment
         message and custom welcome message (professional-scoped,
         not per-patient). Outside the briefing column so it doesn't
         compete for reading attention.

     The patient search is mounted inside the chips picker so a
     long caseload doesn't have to scroll past a fixed sidebar; the
     critical alerts are surfaced as a chip row at the top of the
     picker, since they're a triage signal you want at hand while
     picking a patient to brief on.
═══════════════════════════════════════════════════════════════ --%>

<div class="pt ptd-wrap">
  <%!-- ── Header ── --%>
  <div class="ptd-head">
    <div>
      <p class="pt-eyebrow">Centro de Control</p>
      <h1 class="pt-h1">
        {@current_professional.full_name || "Profesional Clínico"}
      </h1>
    </div>

    <div style="display:flex; align-items:center; gap:14px;">
      <.live_component
        module={NotificationCenter}
        id="notification-center"
        professional_id={@current_professional.id}
      />
    </div>
  </div>

  <%!-- ── Triage strip — critical alerts as chips ── --%>
  <%= if @critical_patients != [] do %>
    <div class="pta-triage">
      <span class="pt-eyebrow" style="color:#b91c1c;">Alertas críticas</span>
      <.link
        :for={patient <- @critical_patients}
        patch={~p"/dashboard/patients/#{patient.id}"}
        class="pta-chip pta-chip--risk"
      >
        <span class="pt-avatar pt-avatar--risk" style="width:24px; height:24px; font-size:10px;">
          {initials(patient.alias)}
        </span>
        {patient.alias}
      </.link>
    </div>
  <% end %>

  <%!-- ── Picker toggle ── --%>
  <div class="ptd-toggle" role="group" aria-label="Cómo elegir el paciente">
    <.link
      patch={picker_path(@selected_patient, "chips")}
      class={["ptd-toggle__btn", @picker == "chips" && "ptd-toggle__btn--on"]}
    >
      Pacientes
    </.link>
    <.link
      patch={picker_path(@selected_patient, "week")}
      class={["ptd-toggle__btn", @picker == "week" && "ptd-toggle__btn--on"]}
    >
      Semana
    </.link>
  </div>

  <%!-- ── Picker: chips with search + patient list ── --%>
  <div :if={@picker == "chips"} class="pta-picker">
    <.live_component
      module={AletheaWeb.DashboardLive.Components.PatientSearch}
      id="patient-search"
      patients={@patients}
      selected_patient_id={@selected_patient && @selected_patient.id}
      telegram_statuses={@telegram_statuses}
      invited_ids={@invited_ids}
    />
    <div :if={@selected_patient} class="pta-chip pta-chip--active" style="cursor:default;">
      <span class="pt-avatar" style="width:24px; height:24px; font-size:10px;">
        {initials(@selected_patient.alias)}
      </span>
      {@selected_patient.alias} · seleccionado
    </div>
  </div>

  <%!-- ── Picker: week agenda ── --%>
  <div :if={@picker == "week"} class="ptc-week">
    <div
      :for={day <- 1..7}
      class={["ptc-day", day == @today_day_of_week && "ptc-day--today"]}
    >
      <div class="ptc-day__name">{day_name(day)}</div>
      <%= for patient <- Map.get(@by_day, day, []) do %>
        <.link
          patch={~p"/dashboard/patients/#{patient.id}"}
          class={[
            "ptc-slot",
            patient.urgent_intervention && "ptc-slot--risk",
            @selected_patient && @selected_patient.id == patient.id && "ptc-slot--on"
          ]}
        >
          {patient.alias}
          <small>{format_time(patient.session_time)}</small>
        </.link>
      <% end %>
      <%= if Map.get(@by_day, day, []) == [] do %>
        <div class="ptc-slot" style="opacity:.5; cursor:default;">—</div>
      <% end %>
    </div>
  </div>

  <%!-- ── Empty state — no patient selected ── --%>
  <div :if={!@selected_patient} class="pt-card">
    <div class="pt-empty">
      {if @picker == "week",
        do: "Elegí una sesión de la semana para preparar el encuentro.",
        else: "Elegí un paciente arriba para leer su briefing de la semana."}
    </div>
  </div>

  <%!-- ── Briefing body (when patient selected) ── --%>
  <div :if={@selected_patient}>
    <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px;">
      <h2 class="pt-h2">Briefing · {@selected_patient.alias}</h2>
      <span class={"pt-pill " <> mood_pill(@mood_signal)}>{@mood_signal.label}</span>
    </div>

    <%!-- Weekly pre-session report — article card --%>
    <article
      id="weekly-pre-session-report"
      data-status-tone={status_tone(@weekly_summary)}
      class="pta-briefing"
    >
      <p class="pt-eyebrow" style="margin-bottom:10px;">
        Resumen semanal
        <span :if={@weekly_summary}>· {format_summary_date(@weekly_summary.period_end)}</span>
        <span
          :if={@weekly_summary}
          id="weekly-status-badge"
          class={"pt-pill " <> status_pill(@weekly_summary.status_level)}
        >
          {@weekly_summary.status_level}
        </span>
      </p>
      <p :if={@weekly_summary} class="pta-briefing__text">
        {@weekly_summary.summary_text}
      </p>
      <p :if={!@weekly_summary} class="pt-muted" style="font-style:italic;">
        Sin resumen semanal generado todavía.
      </p>

      <%!-- Metric strip (the four from #115) — only when the report filled at least one --%>
      <div
        :if={weekly_metrics?(@weekly_summary)}
        id="weekly-metrics"
        class="pta-metrics"
      >
        <.metric_tile
          id="weekly-metric-anxiety"
          label="Ansiedad"
          value={format_score(@weekly_summary.anxiety_score)}
        />
        <.metric_tile
          id="weekly-metric-social"
          label="Social"
          value={format_score(@weekly_summary.social_score)}
        />
        <.metric_tile
          id="weekly-metric-crisis"
          label="Crisis"
          value={format_count(@weekly_summary.crisis_events)}
        />
        <.metric_tile
          id="weekly-metric-sessions"
          label="Sesiones"
          value={format_count(@weekly_summary.session_count)}
        />
      </div>
    </article>

    <%!-- Emotion trends — progress bars per emotion --%>
    <div :if={@emotion_rows != []} id="emotion-trends" class="pt-card">
      <div class="pt-card__head">
        <span class="pt-h2">Tendencias Emocionales</span>
        <span class="pt-eyebrow">Últimos 7 días</span>
      </div>
      <div class="pt-card__body">
        <div style="display:flex; flex-direction:column; gap:10px;">
          <%= for emotion <- @emotion_rows do %>
            <div id={"emotion-row-#{emotion.key}"}>
              <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:4px;">
                <span style="font-size:12px; font-weight:600; color:#475569;">
                  {emotion.label}
                </span>
                <span style="font-size:12px; font-weight:700; color:#1e293b; font-variant-numeric:tabular-nums;">
                  {emotion.percent}%
                </span>
              </div>
              <progress
                class={"progress " <> emotion.progress_class}
                value={emotion.percent}
                max="100"
                style="height:8px; width:100%; border-radius:4px;"
              >
              </progress>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- Emotion chart — 7-day daily breakdown --%>
    <div id="emotion-chart" class="pt-card">
      <div class="pt-card__head">
        <span class="pt-h2">Evolución Emocional</span>
        <span class="pt-eyebrow">Últimos 7 días</span>
      </div>
      <div class="pt-card__body">
        <EmotionChart.emotion_chart daily_data={@emotion_chart_data} />
      </div>
    </div>

    <%!-- Session snapshots — past clinical sessions --%>
    <h3 class="pt-h2" style="margin-bottom:14px;">Sesiones anteriores</h3>
    <div :if={@session_summaries == []} class="pt-card">
      <div class="pt-empty">Sin sesiones con seguimiento clínico aún.</div>
    </div>
    <div :if={@session_summaries != []} class="pta-timeline">
      <div :for={summary <- @session_summaries} class="pta-timeline__item">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <strong style="font-size:13px;">{format_summary_date(summary.period_end)}</strong>
          <span class={"pt-pill " <> status_pill(summary.status_level)}>
            {summary.status_level}
          </span>
        </div>
        <p class="pt-muted">{summary.summary_text}</p>
      </div>
    </div>

    <%!-- Schedule form + chat decrypt (per-patient) --%>
    <div class="pt-card" style="margin-top:20px;">
      <div class="pt-card__head">
        <span class="pt-h2">Sesión y chat</span>
      </div>
      <div
        class="pt-card__body"
        style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:20px;"
      >
        <.form for={%{}} id="schedule-form" phx-submit="save_session_schedule">
          <h4 style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:#94a3b8; margin-bottom:10px;">
            Horario de Sesión
          </h4>
          <div style="margin-bottom:8px;">
            <label style="font-size:11px; font-weight:600; color:#475569; display:block; margin-bottom:4px;">
              Día
            </label>
            <select
              name="day"
              style="width:100%; padding:6px 10px; border:1px solid #e2e8f0; border-radius:8px; font-size:13px; background:#fff; color:#334155;"
            >
              <%= for {value, label} <- day_options() do %>
                <option value={value} selected={@selected_patient.session_day_of_week == value}>
                  {label}
                </option>
              <% end %>
            </select>
          </div>
          <div style="margin-bottom:10px;">
            <label style="font-size:11px; font-weight:600; color:#475569; display:block; margin-bottom:4px;">
              Hora
            </label>
            <input
              type="time"
              name="time"
              value={format_session_time(@selected_patient.session_time)}
              style="width:100%; padding:6px 10px; border:1px solid #e2e8f0; border-radius:8px; font-size:13px; background:#fff; color:#334155;"
            />
          </div>
          <button
            type="submit"
            class="btn btn-primary"
            style="width:100%; font-size:12px; height:36px; border-radius:10px;"
          >
            Guardar cambios
          </button>
        </.form>

        <div>
          <h4 style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:#94a3b8; margin-bottom:10px;">
            Historial Clínico
          </h4>
          <button
            id="decrypt-chat-button"
            type="button"
            phx-click="decrypt_chat"
            class={["pt-btn", @chat_decrypted && "pt-btn--ghost"]}
          >
            {if @chat_decrypted, do: "Chat descifrado", else: "Descifrar chat"}
          </button>
          <div
            :if={@chat_decrypted}
            id="chat-history-panel"
            phx-update="stream"
            style="margin-top:12px; max-height:300px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:12px; background:#fafbfc; padding:8px;"
          >
            <div
              :for={{id, msg} <- @streams.decrypted_messages}
              id={id}
              class={"chat " <> if(msg.direction == "inbound", do: "chat-start", else: "chat-end")}
            >
              <div class="chat-header" style="font-size:9px; color:#94a3b8; margin-bottom:2px;">
                {Calendar.strftime(msg.timestamp, "%H:%M")}
              </div>
              <div
                class={"chat-bubble " <> if(msg.direction == "outbound", do: "chat-bubble-primary", else: "")}
                style="font-size:12px; line-height:1.5;"
              >
                {msg.encrypted_content}
              </div>
            </div>
          </div>
        </div>

        <%!-- Telegram invite — per-patient status + invite/regenerate button.
             Sits in the same grid as Horario + Chat because all three are
             setup actions for the selected patient. --%>
        <div>
          <h4 style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:#94a3b8; margin-bottom:10px;">
            Telegram
          </h4>
          <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:10px;">
            <span
              id={"tg-status-" <> @selected_patient.id}
              class={tg_status_class(@telegram_statuses, @selected_patient.id)}
              style="font-weight:600; font-size:10px;"
            >
              {tg_status_label(@telegram_statuses, @selected_patient.id)}
            </span>
            <button
              id={"tg-btn-" <> @selected_patient.id}
              type="button"
              phx-click={tg_button_event(@telegram_statuses, @selected_patient.id, @invited_ids)}
              phx-value-id={@selected_patient.id}
              disabled={tg_status(@telegram_statuses, @selected_patient.id) == :connected}
              class={[
                "pt-btn",
                tg_status(@telegram_statuses, @selected_patient.id) == :connected &&
                  "pt-btn--ghost"
              ]}
            >
              {tg_button_label(@telegram_statuses, @selected_patient.id, @invited_ids)}
            </button>
          </div>
          <p style="font-size:10px; color:#94a3b8; line-height:1.4; margin:0;">
            Generá un enlace de Telegram para que el paciente se conecte a Alethea. El código de 6 dígitos vence a los 10 minutos.
          </p>
        </div>
      </div>
    </div>
  </div>

  <%!-- ── Telegram invite modal (renders when @invite_modal is set) ── --%>
  <dialog
    :if={@invite_modal}
    id="invite-modal"
    open
    style="border:none; border-radius:16px; padding:0; max-width:520px; width:90%; box-shadow:0 24px 64px rgba(15,23,42,.35);"
  >
    <div style="padding:20px 24px; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; gap:10px;">
      <h3 style="font-size:15px; font-weight:700; margin:0; flex:1;">
        Invitar a <span id="invite-patient-alias">{@invite_modal.patient_alias}</span>
      </h3>
      <button
        id="invite-close"
        type="button"
        phx-click="close_invite_modal"
        style="border:none; background:transparent; color:#64748b; font-size:18px; cursor:pointer;"
      >
        ×
      </button>
    </div>
    <div style="padding:20px 24px;">
      <p :if={@invite_modal.deep_link} style="font-size:11px; color:#94a3b8; margin:0 0 8px;">
        Enlace de Telegram
      </p>
      <.link
        :if={@invite_modal.deep_link}
        id="invite-deep-link"
        href={@invite_modal.deep_link}
        target="_blank"
        style="display:block; padding:10px 12px; border:1px solid #e2e8f0; border-radius:8px; background:#f8fafc; color:#1e293b; font-family:monospace; font-size:12px; word-break:break-all; margin-bottom:16px;"
      >
        {@invite_modal.deep_link}
      </.link>

      <p style="font-size:11px; color:#94a3b8; margin:0 0 8px;">
        Código de 6 dígitos
      </p>
      <div
        id="invite-six-digit"
        style="padding:14px; border:1px solid #e2e8f0; border-radius:10px; background:#fff; font-family:monospace; font-size:24px; font-weight:700; letter-spacing:0.4em; text-align:center; color:#1e293b; margin-bottom:16px;"
      >
        {@invite_modal.six_digit_code}
      </div>

      <p style="font-size:11px; color:#94a3b8; margin:0;">
        Vence a las
        <span id="invite-expires-at" style="font-weight:700; color:#475569;">
          {Calendar.strftime(@invite_modal.expires_at, "%H:%M")}
        </span>
        — el paciente tiene 10 minutos para usarlo.
      </p>
    </div>
    <div style="padding:14px 24px; border-top:1px solid #f1f5f9; display:flex; justify-content:flex-end;">
      <button
        id="invite-regenerate"
        type="button"
        phx-click="regenerate_invite"
        phx-value-id={@invite_modal.patient_id}
        class="pt-btn"
      >
        Regenerar
      </button>
    </div>
  </dialog>

  <%!-- ── Settings — professional-scoped bot config (collapsed) ── --%>
  <details class="pta-settings">
    <summary>Configuración de tu bot (aplica a todos tus pacientes)</summary>
    <div class="pta-settings__grid">
      <.form for={%{}} id="crisis-message-form" phx-submit="save_crisis_message">
        <div style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
          <.icon name="hero-megaphone" style="width:12px; height:12px; color:#f59e0b;" />
          <span style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:#f59e0b;">
            Mensaje de Contención
          </span>
        </div>
        <p style="font-size:10px; color:#94a3b8; line-height:1.4; margin-bottom:10px;">
          Enviado automáticamente en crisis detectada por la IA.
        </p>
        <textarea
          name="crisis_message"
          rows="4"
          style="width:100%; padding:8px 10px; border:1px solid #e2e8f0; border-radius:8px; font-size:12px; line-height:1.5; resize:vertical; background:#fff; color:#334155; font-family:inherit;"
          placeholder="Ej: Entiendo que estás pasando por un momento difícil…"
        >{@current_professional.crisis_message}</textarea>
        <button
          type="submit"
          style="width:100%; margin-top:8px; padding:8px; border:1px solid rgba(245,158,11,.3); border-radius:10px; background:rgba(245,158,11,.08); color:#b45309; font-size:12px; font-weight:600; cursor:pointer;"
        >
          Actualizar
        </button>
      </.form>

      <.form for={%{}} id="welcome-message-form" phx-submit="save_welcome_message">
        <div style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
          <.icon
            name="hero-chat-bubble-left-right"
            style="width:12px; height:12px; color:#6366f1;"
          />
          <span style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:#6366f1;">
            Mensaje de Bienvenida
          </span>
        </div>
        <p style="font-size:10px; color:#94a3b8; line-height:1.4; margin-bottom:10px;">
          Enviado al vincular Telegram. Usá {"%{name}"} para incluir el nombre del paciente.
        </p>
        <textarea
          name="welcome_message"
          rows="4"
          style="width:100%; padding:8px 10px; border:1px solid #e2e8f0; border-radius:8px; font-size:12px; line-height:1.5; resize:vertical; background:#fff; color:#334155; font-family:inherit;"
          placeholder="Ej: ¡Hola %{name}! Bienvenido a tu espacio…"
        >{@current_professional.welcome_message}</textarea>
        <button
          type="submit"
          style="width:100%; margin-top:8px; padding:8px; border:1px solid rgba(99,102,241,.3); border-radius:10px; background:rgba(99,102,241,.08); color:#4338ca; font-size:12px; font-weight:600; cursor:pointer;"
        >
          Actualizar
        </button>
      </.form>
    </div>
  </details>
</div>
