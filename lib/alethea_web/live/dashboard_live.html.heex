<%!-- ═══════════════════════════════════════════════════════════
     Alethea · Dashboard — editorial briefing layout.

     Reading order:

       • Header: eyebrow + display h1, with the picker toggle and the
         notification bell as the action cluster on the same line.
       • Triage strip: critical alerts as chips, above everything.
       • Picker: a command bar over a caseload grid (`PatientSearch`),
         or the week agenda — toggled by `<.link>` patches carrying
         `?picker=chips|week`.
       • Briefing: one reading column with the weekly pre-session
         report and its metric strip, the emotion trends and the
         7-day chart, the session snapshots, the schedule form and
         the chat-decrypt control.
       • Settings: collapsed at the bottom — crisis containment and
         welcome message, professional-scoped rather than
         per-patient, so they sit outside the reading column.

     Every class in this template is defined in `editorial.css`. The
     page loads no CSS framework, so a class that is not there paints
     nothing.
═══════════════════════════════════════════════════════════════ --%>
<div class="pt ptd-wrap">
  <%!-- ── Header ── --%>
  <div class="ptd-head">
    <div>
      <p class="pt-eyebrow">Centro de Control</p>

      <h1 class="pt-h1">{@current_professional.full_name || "Profesional Clínico"}</h1>
    </div>

    <div class="page-head__actions">
      <div class="ptd-toggle" role="group" aria-label="Cómo elegir el paciente">
        <.link
          patch={picker_path(@selected_patient, "chips")}
          class={["ptd-toggle__btn", @picker == "chips" && "ptd-toggle__btn--on"]}
        >
          Pacientes
        </.link>
        <.link
          patch={picker_path(@selected_patient, "week")}
          class={["ptd-toggle__btn", @picker == "week" && "ptd-toggle__btn--on"]}
        >
          Semana
        </.link>
      </div>

      <.live_component
        module={NotificationCenter}
        id="notification-center"
        professional_id={@current_professional.id}
      />
    </div>
  </div>
  <%!-- ── Triage strip — critical alerts as chips ── --%>
  <%= if @critical_patients != [] do %>
    <div class="pta-triage">
      <span class="pt-eyebrow pt-eyebrow--danger">Alertas críticas</span>
      <.link
        :for={patient <- @critical_patients}
        patch={~p"/dashboard/patients/#{patient.id}"}
        class="pta-chip pta-chip--risk"
      >
        <span class="pt-avatar pt-avatar--risk" style="width:24px; height:24px; font-size:10px;">
          {initials(patient.alias)}
        </span>
        {patient.alias}
      </.link>
    </div>
  <% end %>
  <%!-- ── Picker: command bar + caseload grid ── --%>
  <div :if={@picker == "chips"}>
    <.live_component
      module={AletheaWeb.DashboardLive.Components.PatientSearch}
      id="patient-search"
      patients={@patients}
      selected_patient_id={@selected_patient && @selected_patient.id}
    />
  </div>
  <%!-- ── Picker: week agenda ── --%>
  <div :if={@picker == "week"} class="ptc-week">
    <div
      :for={day <- 1..7}
      class={["ptc-day", day == @today_day_of_week && "ptc-day--today"]}
    >
      <div class="ptc-day__name">{day_name(day)}</div>

      <%= for patient <- Map.get(@by_day, day, []) do %>
        <.link
          patch={~p"/dashboard/patients/#{patient.id}"}
          class={[
            "ptc-slot",
            patient.urgent_intervention && "ptc-slot--risk",
            @selected_patient && @selected_patient.id == patient.id && "ptc-slot--on"
          ]}
        >
          {patient.alias} <small>{format_time(patient.session_time)}</small>
        </.link>
      <% end %>

      <%= if Map.get(@by_day, day, []) == [] do %>
        <div class="ptc-slot" style="opacity:.5; cursor:default;">—</div>
      <% end %>
    </div>
  </div>
  <%!-- ── Empty state — no patient selected ── --%>
  <div :if={!@selected_patient} class="empty-state">
    <p class="empty-state__title">
      {if @picker == "week", do: "Elegí una sesión de la semana", else: "Elegí un paciente"}
    </p>

    <p class="empty-state__text">
      {if @picker == "week",
        do: "Abrí una sesión de la agenda para preparar el encuentro.",
        else: "Abrí una tarjeta de la grilla para leer el briefing de la semana."}
    </p>
  </div>
  <%!-- ── Briefing body (when patient selected) ── --%>
  <div :if={@selected_patient}>
    <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px;">
      <h2 class="pt-h2">Briefing · {@selected_patient.alias}</h2>
      <span class={"pt-pill " <> mood_pill(@mood_signal)}>{@mood_signal.label}</span>
    </div>
    <%!-- Weekly pre-session report — the briefing's signature surface --%>
    <article
      id="weekly-pre-session-report"
      data-status-tone={status_tone(@weekly_summary)}
      class="pta-briefing"
    >
      <p class="pt-eyebrow" style="margin-bottom:10px;">
        Resumen semanal
        <span :if={@weekly_summary}>· {format_summary_date(@weekly_summary.period_end)}</span>
        <span
          :if={@weekly_summary}
          id="weekly-status-badge"
          class={"pt-pill " <> status_pill(@weekly_summary.status_level)}
        >
          {@weekly_summary.status_level}
        </span>
      </p>

      <p :if={@weekly_summary} class="pta-briefing__text">{@weekly_summary.summary_text}</p>

      <p :if={!@weekly_summary} class="pt-muted" style="font-style:italic;">
        Sin resumen semanal generado todavía.
      </p>
      <%!-- Metric strip — only when the report filled at least one --%>
      <div
        :if={weekly_metrics?(@weekly_summary)}
        id="weekly-metrics"
        class="pta-metrics"
      >
        <.metric_tile
          id="weekly-metric-anxiety"
          label="Ansiedad"
          value={format_score(@weekly_summary.anxiety_score)}
        />
        <.metric_tile
          id="weekly-metric-social"
          label="Social"
          value={format_score(@weekly_summary.social_score)}
        />
        <.metric_tile
          id="weekly-metric-crisis"
          label="Crisis"
          value={format_count(@weekly_summary.crisis_events)}
        />
        <.metric_tile
          id="weekly-metric-sessions"
          label="Sesiones"
          value={format_count(@weekly_summary.session_count)}
        />
      </div>
    </article>
    <%!-- Emotion trends — one meter per emotion --%>
    <div :if={@emotion_rows != []} id="emotion-trends" class="pt-card">
      <div class="pt-card__head">
        <span class="pt-h2">Tendencias Emocionales</span>
        <span class="pt-eyebrow">Últimos 7 días</span>
      </div>

      <div class="pt-card__body">
        <div style="display:flex; flex-direction:column; gap:12px;">
          <div :for={emotion <- @emotion_rows} id={"emotion-row-#{emotion.key}"}>
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:5px;">
              <span class="pta-emotion__label">{emotion.label}</span>
              <span class="pta-emotion__value">{emotion.percent_label}</span>
            </div>

            <div
              class="meter"
              role="img"
              aria-label={"#{emotion.label}: #{emotion.percent}%"}
            >
              <div
                class={"meter__fill " <> emotion.meter_class}
                style={"width:#{emotion.percent}%;"}
              >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <%!-- Emotion chart — 7-day daily breakdown --%>
    <div id="emotion-chart" class="pt-card">
      <div class="pt-card__head">
        <span class="pt-h2">Evolución Emocional</span>
        <span class="pt-eyebrow">Últimos 7 días</span>
      </div>

      <div class="pt-card__body">
        <EmotionChart.emotion_chart daily_data={@emotion_chart_data} />
      </div>
    </div>
    <%!-- Session snapshots — past clinical sessions --%>
    <h3 class="pt-h2" style="margin-bottom:14px;">Sesiones anteriores</h3>

    <div :if={@session_summaries == []} class="empty-state">
      <p class="empty-state__text" style="margin-bottom:0;">
        Sin sesiones con seguimiento clínico aún.
      </p>
    </div>

    <div :if={@session_summaries != []} class="pta-timeline">
      <div :for={summary <- @session_summaries} class="pta-timeline__item">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <strong style="font-size:13px;">{format_summary_date(summary.period_end)}</strong>
          <span class={"pt-pill " <> status_pill(summary.status_level)}>
            {summary.status_level}
          </span>
        </div>

        <p class="pt-muted">{summary.summary_text}</p>
      </div>
    </div>
    <%!-- Schedule form + chat decrypt + Telegram invite (per-patient) --%>
    <div class="pt-card" style="margin-top:20px;">
      <div class="pt-card__head"><span class="pt-h2">Sesión y chat</span></div>

      <div
        class="pt-card__body"
        style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:24px;"
      >
        <.form for={%{}} id="schedule-form" phx-submit="save_session_schedule">
          <h4 class="pta-field-title">Horario de Sesión</h4>

          <div style="margin-bottom:8px;">
            <label class="pta-label" for="schedule-day">Día</label>
            <select id="schedule-day" name="day" class="text-input text-input--compact">
              <option
                :for={{value, label} <- day_options()}
                value={value}
                selected={@selected_patient.session_day_of_week == value}
              >
                {label}
              </option>
            </select>
          </div>

          <div style="margin-bottom:12px;">
            <label class="pta-label" for="schedule-time">Hora</label>
            <input
              id="schedule-time"
              type="time"
              name="time"
              value={format_session_time(@selected_patient.session_time)}
              class="text-input text-input--compact"
            />
          </div>

          <button type="submit" class="button-primary button-primary--sm button-primary--block">
            Guardar cambios
          </button>
        </.form>

        <div>
          <h4 class="pta-field-title">Historial Clínico</h4>

          <button
            id="decrypt-chat-button"
            type="button"
            phx-click="decrypt_chat"
            class={[
              "button-secondary button-secondary--sm",
              @chat_decrypted && "button-secondary--block"
            ]}
          >
            {if @chat_decrypted, do: "Chat descifrado", else: "Descifrar chat"}
          </button>
          <div
            :if={@chat_decrypted}
            id="chat-history-panel"
            phx-update="stream"
            class="pta-chatlog"
          >
            <div
              :for={{id, msg} <- @streams.decrypted_messages}
              id={id}
              class={["chat-line", msg.direction == "outbound" && "chat-line--out"]}
            >
              <div class="pta-chatlog__time">
                {Calendar.strftime(msg.timestamp, "%H:%M")}
              </div>

              <div class="chat-bubble">{msg.encrypted_content}</div>
            </div>
          </div>
        </div>

        <%!-- Telegram invite — per-patient status + invite/regenerate button.
             Sits in the same grid as Horario + Chat because all three are
             setup actions for the selected patient. --%>
        <div>
          <h4 class="pta-field-title">Telegram</h4>

          <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:10px;">
            <span
              id={"tg-status-" <> @selected_patient.id}
              class={tg_status_class(@telegram_statuses, @selected_patient.id)}
            >
              {tg_status_label(@telegram_statuses, @selected_patient.id)}
            </span>
            <button
              id={"tg-btn-" <> @selected_patient.id}
              type="button"
              phx-click={tg_button_event(@telegram_statuses, @selected_patient.id, @invited_ids)}
              phx-value-id={@selected_patient.id}
              disabled={tg_status(@telegram_statuses, @selected_patient.id) == :connected}
              class="button-secondary button-secondary--sm"
            >
              {tg_button_label(@telegram_statuses, @selected_patient.id, @invited_ids)}
            </button>
          </div>

          <%!-- Invite disclosure — an inline region, never a modal: the
               professional reads the code off the screen while talking to
               the patient, so it must not trap focus or hide the column
               behind it. --%>
          <section
            :if={@invite_panel && @invite_panel.patient_id == @selected_patient.id}
            id="telegram-invite-panel"
            role="region"
            aria-live="polite"
            aria-labelledby="invite-panel-title"
            class="invite-panel"
          >
            <div class="invite-panel__head">
              <div>
                <h3 id="invite-panel-title" class="invite-panel__title">
                  Invitación para
                  <span id="invite-patient-alias">{@invite_panel.patient_alias}</span>
                </h3>

                <p class="pta-hint">Compartí una de estas opciones con el paciente.</p>
              </div>

              <button
                id="invite-dismiss"
                type="button"
                phx-click="dismiss_invite"
                aria-label="Ocultar invitación"
                class="button-secondary button-secondary--sm"
              >
                Ocultar
              </button>
            </div>

            <p :if={@invite_panel.deep_link} class="pta-hint" style="margin:0 0 6px;">
              Enlace de Telegram
            </p>

            <.link
              :if={@invite_panel.deep_link}
              id="invite-deep-link"
              href={@invite_panel.deep_link}
              target="_blank"
              rel="noopener noreferrer"
              class="pta-code-link"
              style="margin-bottom:14px;"
            >
              {@invite_panel.deep_link}
            </.link>
            <p class="pta-hint" style="margin:0 0 6px;">Código de 6 dígitos</p>

            <div id="invite-six-digit" class="pta-code" style="margin-bottom:14px;">
              {@invite_panel.six_digit_code}
            </div>

            <div class="invite-panel__foot">
              <p class="pta-hint" style="margin:0;">
                Vence a las
                <span id="invite-expires-at" class="pta-hint__strong">
                  {Calendar.strftime(@invite_panel.expires_at, "%H:%M")}
                </span>
                — el paciente tiene 10 minutos para usarlo.
              </p>

              <button
                id="invite-regenerate"
                type="button"
                phx-click="regenerate_invite"
                phx-value-id={@invite_panel.patient_id}
                class="button-secondary button-secondary--sm"
              >
                Regenerar
              </button>
            </div>
          </section>

          <p class="pta-hint pta-hint--xs" style="margin:0;">
            Generá un enlace de Telegram para que el paciente se conecte a Alethea. El código de 6 dígitos vence a los 10 minutos.
          </p>
        </div>
      </div>
    </div>
  </div>
  <%!-- ── Settings — professional-scoped bot config (collapsed) ── --%>
  <details class="pta-settings">
    <summary>Configuración de tu bot (aplica a todos tus pacientes)</summary>

    <div class="pta-settings__grid">
      <.form
        for={%{}}
        id="crisis-message-form"
        phx-submit="save_crisis_message"
        class="pta-nudge pta-nudge--crisis"
      >
        <div class="pta-nudge__label">
          <.icon name="hero-megaphone" class="pta-nudge__icon" />
          <span>Mensaje de Contención</span>
        </div>

        <p class="pta-hint pta-hint--xs" style="margin-bottom:10px;">
          Enviado automáticamente en crisis detectada por la IA.
        </p>
        <textarea
          name="crisis_message"
          rows="4"
          aria-label="Mensaje de contención"
          class="text-input text-input--multiline"
          placeholder="Ej: Entiendo que estás pasando por un momento difícil…"
        >{@current_professional.crisis_message}</textarea>
        <button type="submit" class="pta-nudge__submit">Actualizar</button>
      </.form>

      <.form
        for={%{}}
        id="welcome-message-form"
        phx-submit="save_welcome_message"
        class="pta-nudge pta-nudge--welcome"
      >
        <div class="pta-nudge__label">
          <.icon name="hero-chat-bubble-left-right" class="pta-nudge__icon" />
          <span>Mensaje de Bienvenida</span>
        </div>

        <p class="pta-hint pta-hint--xs" style="margin-bottom:10px;">
          Enviado al vincular Telegram. Usá {"%{name}"} para incluir el nombre del paciente.
        </p>
        <textarea
          name="welcome_message"
          rows="4"
          aria-label="Mensaje de bienvenida"
          class="text-input text-input--multiline"
          placeholder="Ej: ¡Hola %{name}! Bienvenido a tu espacio…"
        >{@current_professional.welcome_message}</textarea>
        <button type="submit" class="pta-nudge__submit">Actualizar</button>
      </.form>
    </div>
  </details>
</div>
