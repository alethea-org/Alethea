<%!-- ═══════════════════════════════════════════════════════════
     Alethea · Dashboard de Riesgo y Snapshots
     Uses: FlyonUI semantic classes (card, badge, progress, chat…)
           + dashboard-* layout classes from app.css
═══════════════════════════════════════════════════════════ --%>
<%!-- ── Header + stats ── --%>
<div style="margin-bottom:24px;">
  <div style="display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:12px;">
    <div>
      <p style="font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:0.1em; color:#94a3b8;">
        Alethea · Centro de Control
      </p>

      <h1 style="font-size:22px; font-weight:800; color:#1e293b; letter-spacing:-0.02em; margin-top:2px;">
        {@current_professional.full_name || "Profesional Clínico"}
      </h1>
    </div>

    <.live_component
      module={NotificationCenter}
      id="notification-center"
      professional_id={@current_professional.id}
    />
  </div>
  <%!-- Stats — FlyonUI stat component --%>
  <div
    class="stats"
    style="border:1px solid #e2e8f0; border-radius:16px; background:#fff; box-shadow:0 1px 3px rgba(0,0,0,.04); display:inline-flex;"
  >
    <div class="stat" style="padding:16px 24px;">
      <div class="stat-figure" style="color:#6366f1;">
        <.icon name="hero-users" style="width:28px; height:28px;" />
      </div>

      <div
        class="stat-title"
        style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em;"
      >
        Pacientes
      </div>

      <div class="stat-value" style="font-size:22px; font-weight:800;">{length(@patients)}</div>

      <div class="stat-desc" style="font-size:11px; color:#94a3b8;">Activos en seguimiento</div>
    </div>

    <div class="stat" style="padding:16px 24px;">
      <div class="stat-figure" style="color:#ef4444;">
        <.icon name="hero-exclamation-triangle" style="width:28px; height:28px;" />
      </div>

      <div
        class="stat-title"
        style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em;"
      >
        Alertas
      </div>

      <div class="stat-value" style="font-size:22px; font-weight:800; color:#ef4444;">
        {length(@critical_patients)}
      </div>

      <div class="stat-desc" style="font-size:11px; color:#94a3b8;">
        {if @critical_patients == [], do: "Sin alertas activas", else: "Requieren atención"}
      </div>
    </div>
  </div>
</div>
<%!-- ── Two-column layout: patient sidebar + detail ── --%>
<div class="dashboard-grid">
  <%!-- ──── LEFT: Patient sidebar ──── --%>
  <div class="dashboard-sidebar">
    <%!-- Critical alerts card --%>
    <div
      id="critical-alerts-card"
      style={
      "border-radius:16px; overflow:hidden; border:1px solid " <>
      if(@critical_patients == [], do: "#e2e8f0", else: "rgba(239,68,68,.25)") <>
      "; background:" <>
      if(@critical_patients == [], do: "#fff", else: "rgba(254,242,242,.5)")
    }
    >
      <div style={
        "display:flex; align-items:center; gap:8px; padding:10px 14px; border-bottom:1px solid " <>
        if(@critical_patients == [], do: "#f1f5f9", else: "rgba(239,68,68,.15)") <>
        "; background:" <>
        if(@critical_patients == [], do: "transparent", else: "rgba(254,226,226,.4)")
      }>
        <.icon
          name="hero-exclamation-triangle"
          style={"width:14px; height:14px; color:" <> if(@critical_patients == [], do: "#94a3b8", else: "#ef4444")}
        />
        <span style={"font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:" <> if(@critical_patients == [], do: "#94a3b8", else: "#ef4444")}>
          Alertas Críticas
        </span>
        <%= if @critical_patients != [] do %>
          <span class="badge badge-error" style="margin-left:auto; font-size:10px;">
            {length(@critical_patients)}
          </span>
        <% end %>
      </div>

      <%= if @critical_patients == [] do %>
        <div style="padding:24px; text-align:center;">
          <.icon
            name="hero-check-circle"
            style="width:28px; height:28px; color:#22c55e; margin:0 auto 8px; display:block;"
          />
          <p style="font-size:12px; color:#94a3b8;">Sin alertas activas</p>
        </div>
      <% end %>

      <%= for patient <- @critical_patients do %>
        <.link
          patch={~p"/dashboard/patients/#{patient.id}"}
          id={"critical-patient-#{patient.id}"}
          style="display:flex; align-items:center; gap:10px; padding:10px 14px; border-bottom:1px solid rgba(239,68,68,.08); text-decoration:none; transition:background .15s;"
        >
          <%!-- Pulsing red indicator --%>
          <div style="position:relative; flex-shrink:0;">
            <div style="width:32px; height:32px; border-radius:50%; background:rgba(239,68,68,.15); display:flex; align-items:center; justify-content:center;">
              <span style="font-size:10px; font-weight:700; color:#ef4444;">
                {patient.alias
                |> String.split()
                |> Enum.map(&String.first/1)
                |> Enum.take(2)
                |> Enum.join()
                |> String.upcase()}
              </span>
            </div>

            <span
              style="position:absolute; top:0; right:0; width:8px; height:8px; border-radius:50%; background:#ef4444; border:2px solid #fff;"
              class="animate-pulse-dot"
            >
            </span>
          </div>

          <div style="min-width:0; flex:1;">
            <div style="font-size:13px; font-weight:600; color:#1e293b;" class="truncate">
              {patient.alias}
            </div>

            <div style="font-size:10px; color:#ef4444; font-weight:500;">
              Intervención prioritaria
            </div>
          </div>
        </.link>
      <% end %>
    </div>
    <%!-- Patient search + list --%>
    <.live_component
      module={AletheaWeb.DashboardLive.Components.PatientSearch}
      id="patient-search"
      patients={@patients}
      selected_patient_id={@selected_patient && @selected_patient.id}
      telegram_statuses={@telegram_statuses}
      invited_ids={@invited_ids}
    />
  </div>
  <%!-- ──── RIGHT: Detail panel ──── --%>
  <div class="dashboard-main">
    <%!-- Empty state --%>
    <div
      :if={!@selected_patient}
      id="dashboard-empty-state"
      style="border:2px dashed #e2e8f0; border-radius:16px; background:#fff; min-height:320px; display:flex; align-items:center; justify-content:center;"
    >
      <div style="text-align:center; padding:40px;">
        <div style="width:56px; height:56px; border-radius:16px; background:#eef2ff; display:flex; align-items:center; justify-content:center; margin:0 auto 14px;">
          <.icon name="hero-user-circle" style="width:28px; height:28px; color:#818cf8;" />
        </div>

        <h2 style="font-size:15px; font-weight:700; color:#64748b; margin-bottom:4px;">
          Selecciona un paciente
        </h2>

        <p style="font-size:13px; color:#94a3b8;">El detalle clínico aparecerá aquí.</p>
      </div>
    </div>
    <%!-- Patient detail --%>
    <div :if={@selected_patient} id="dashboard-patient-detail">
      <%!-- Patient header — mood semaphore --%>
      <div style="border:1px solid #e2e8f0; border-radius:16px; background:#fff; padding:16px 20px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:16px;">
        <div style="display:flex; align-items:center; gap:14px;">
          <%!-- Avatar with indicator --%>
          <div style="position:relative;">
            <div style="width:44px; height:44px; border-radius:50%; background:rgba(99,102,241,.1); display:flex; align-items:center; justify-content:center;">
              <span style="font-size:14px; font-weight:700; color:#6366f1;">
                {@selected_patient.alias
                |> String.split()
                |> Enum.map(&String.first/1)
                |> Enum.take(2)
                |> Enum.join()
                |> String.upcase()}
              </span>
            </div>

            <%= if @selected_patient.urgent_intervention do %>
              <span
                style="position:absolute; top:0; right:0; width:10px; height:10px; border-radius:50%; background:#ef4444; border:2px solid #fff;"
                class="animate-pulse-dot"
              >
              </span>
            <% end %>
          </div>

          <div>
            <div style="display:flex; align-items:center; gap:6px;">
              <span
                style={"width:8px; height:8px; border-radius:50%; " <> @mood_signal.dot_class}
                class={
                  if(@selected_patient.urgent_intervention, do: "animate-pulse-dot", else: "")
                }
              >
              </span>
              <h2 style="font-size:17px; font-weight:700; color:#1e293b;">
                {@selected_patient.alias}
              </h2>
            </div>

            <p style="font-size:11px; color:#94a3b8; margin-top:2px;">Detalle clínico activo</p>
          </div>
        </div>

        <span
          class={"badge " <> @mood_signal.badge_class}
          style="font-weight:600; font-size:11px;"
        >
          {@mood_signal.label}
        </span>
         <%!-- Telegram invite: connection badge + invite/regenerate button --%>
        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
          <span
            id={"tg-status-" <> @selected_patient.id}
            class={tg_status_class(@telegram_statuses, @selected_patient.id)}
            style="font-weight:600; font-size:10px;"
          >
            {tg_status_label(@telegram_statuses, @selected_patient.id)}
          </span>
          <button
            id={"tg-btn-" <> @selected_patient.id}
            type="button"
            phx-click={tg_button_event(@telegram_statuses, @selected_patient.id, @invited_ids)}
            phx-value-id={@selected_patient.id}
            disabled={tg_status(@telegram_statuses, @selected_patient.id) == :connected}
            class="btn"
            style={
              "font-size:11px; height:32px; padding:0 14px; border-radius:10px; font-weight:600; display:inline-flex; align-items:center; gap:6px; border:1px solid rgba(99,102,241,.3); background:rgba(99,102,241,.08); color:#4338ca; cursor:pointer;" <>
                if(tg_status(@telegram_statuses, @selected_patient.id) == :connected,
                  do: " opacity:.55; cursor:default;",
                  else: ""
                )
            }
          >
            <.icon name="hero-paper-airplane" style="width:13px; height:13px;" /> {tg_button_label(
              @telegram_statuses,
              @selected_patient.id,
              @invited_ids
            )}
          </button>
        </div>
      </div>
      <%!-- Detail grid: reports left, controls right --%>
      <div class="dashboard-detail-grid">
        <%!-- ── Left: clinical content ── --%>
        <div style="display:flex; flex-direction:column; gap:16px;">
          <%!-- Weekly Pre-Session Report --%>
          <div
            id="weekly-pre-session-report"
            data-status-tone={status_tone(@weekly_summary)}
            style={"border:1px solid rgba(#{weekly_tone_rgb(@weekly_summary)},.2); border-radius:16px; overflow:hidden;"}
          >
            <div style={"background:rgba(#{weekly_tone_rgb(@weekly_summary)},.06); border-bottom:1px solid rgba(#{weekly_tone_rgb(@weekly_summary)},.12); padding:10px 16px; display:flex; align-items:center; justify-content:space-between; gap:8px;"}>
              <div style="display:flex; align-items:center; gap:8px;">
                <.icon
                  name="hero-clipboard-document-check"
                  style={"width:14px; height:14px; color:rgb(#{weekly_tone_rgb(@weekly_summary)});"}
                />
                <span style={"font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:rgb(#{weekly_tone_rgb(@weekly_summary)});"}>
                  Weekly Pre-Session Report
                </span>
              </div>

              <div :if={@weekly_summary} style="display:flex; align-items:center; gap:8px;">
                <span
                  id="weekly-status-badge"
                  style={"font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; padding:2px 8px; border-radius:999px; background:rgba(#{weekly_tone_rgb(@weekly_summary)},.14); color:rgb(#{weekly_tone_rgb(@weekly_summary)});"}
                >
                  {@weekly_summary.status_level}
                </span>
                <span style="font-size:10px; color:#94a3b8;">
                  {format_summary_date(@weekly_summary.period_end)}
                </span>
              </div>
            </div>

            <div style="padding:14px 16px; background:#fff;">
              <div :if={@weekly_summary} style="font-size:13px; line-height:1.6; color:#475569;">
                {@weekly_summary.summary_text}
              </div>
              <%!-- Metric strip — hidden entirely when the report filled none of them --%>
              <div
                :if={weekly_metrics?(@weekly_summary)}
                id="weekly-metrics"
                style="margin-top:14px; padding-top:12px; border-top:1px solid #f1f5f9; display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:8px;"
              >
                <.metric_tile
                  id="weekly-metric-anxiety"
                  label="Ansiedad"
                  value={format_score(@weekly_summary.anxiety_score)}
                />
                <.metric_tile
                  id="weekly-metric-social"
                  label="Social"
                  value={format_score(@weekly_summary.social_score)}
                />
                <.metric_tile
                  id="weekly-metric-crisis"
                  label="Crisis"
                  value={format_count(@weekly_summary.crisis_events)}
                />
                <.metric_tile
                  id="weekly-metric-sessions"
                  label="Sesiones"
                  value={format_count(@weekly_summary.session_count)}
                />
              </div>

              <div :if={!@weekly_summary} style="text-align:center; padding:16px 0;">
                <.icon
                  name="hero-document-text"
                  style="width:24px; height:24px; color:#cbd5e1; margin:0 auto 8px; display:block;"
                />
                <p style="font-size:13px; color:#94a3b8; font-style:italic;">
                  Sin reportes semanales aún.
                </p>
              </div>
            </div>
          </div>
          <%!-- Emotion trends — progress bars --%>
          <div
            id="emotion-trends"
            style="border:1px solid #e2e8f0; border-radius:16px; padding:16px; background:#fff;"
          >
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;">
              <span style="font-size:13px; font-weight:700; color:#1e293b;">
                Tendencias Emocionales
              </span>
              <span class="badge badge-ghost" style="font-size:9px; font-weight:600;">
                Últimos 7 días
              </span>
            </div>

            <%= if @emotion_rows == [] do %>
              <div style="text-align:center; padding:20px 0;">
                <.icon
                  name="hero-chart-bar"
                  style="width:24px; height:24px; color:#cbd5e1; margin:0 auto 8px; display:block;"
                />
                <p style="font-size:13px; color:#94a3b8;">Esperando sincronización…</p>
              </div>
            <% end %>

            <div style="display:flex; flex-direction:column; gap:10px;">
              <%= for emotion <- @emotion_rows do %>
                <div id={"emotion-row-#{emotion.key}"}>
                  <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:4px;">
                    <span style="font-size:12px; font-weight:600; color:#475569;">
                      {emotion.label}
                    </span>
                    <span style="font-size:12px; font-weight:700; color:#1e293b; font-variant-numeric:tabular-nums;">
                      {emotion.percent}%
                    </span>
                  </div>

                  <progress
                    class={"progress " <> emotion.progress_class}
                    value={emotion.percent}
                    max="100"
                    style="height:8px; width:100%; border-radius:4px;"
                  >
                  </progress>
                </div>
              <% end %>
            </div>
          </div>
          <%!-- Emotion SVG bar chart — 7-day daily breakdown --%>
          <div
            id="emotion-chart"
            style="border:1px solid #e2e8f0; border-radius:16px; padding:16px; background:#fff;"
          >
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
              <span style="font-size:13px; font-weight:700; color:#1e293b;">
                Evolución Emocional
              </span>
              <span class="badge badge-ghost" style="font-size:9px; font-weight:600;">
                Últimos 7 días
              </span>
            </div>
            <EmotionChart.emotion_chart daily_data={@emotion_chart_data} />
          </div>
          <%!-- Session Snapshots — accordion --%>
          <div id="session-snapshots">
            <div style="display:flex; align-items:center; gap:6px; margin-bottom:8px; padding:0 4px;">
              <.icon name="hero-clock" style="width:14px; height:14px; color:#94a3b8;" />
              <span style="font-size:13px; font-weight:700; color:#1e293b;">
                Session Snapshots
              </span>
            </div>

            <%= if @session_summaries == [] do %>
              <div style="border:2px dashed #e2e8f0; border-radius:16px; padding:32px; text-align:center; background:#fff;">
                <p style="font-size:13px; color:#94a3b8;">
                  Sin sesiones con seguimiento clínico aún.
                </p>
              </div>
            <% end %>

            <%= if @session_summaries != [] do %>
              <div style="border:1px solid #e2e8f0; border-radius:16px; overflow:hidden; background:#fff;">
                <%= for summary <- @session_summaries do %>
                  <details
                    id={"session-summary-#{summary.id}"}
                    style="border-bottom:1px solid #f1f5f9;"
                  >
                    <summary style="display:flex; cursor:pointer; list-style:none; align-items:center; gap:10px; padding:10px 14px; transition:background .15s;">
                      <span
                        class={"badge " <> cond do
                        summary.status_level == "Estable" -> "badge-success"
                        summary.status_level == "Alerta" -> "badge-warning"
                        summary.status_level == "Crítico" -> "badge-error"
                        true -> "badge-ghost"
                      end}
                        style="font-size:9px; font-weight:700; text-transform:uppercase; flex-shrink:0;"
                      >
                        {summary.status_level}
                      </span>
                      <span style="font-size:13px; color:#64748b; flex:1;">
                        Sesión del {format_summary_date(summary.period_end)}
                      </span>
                      <.icon
                        name="hero-chevron-down"
                        style="width:14px; height:14px; color:#94a3b8; transition:transform .2s;"
                      />
                    </summary>

                    <div style="padding:10px 14px 14px; font-size:13px; line-height:1.6; color:#475569; border-top:1px solid #f1f5f9;">
                      {summary.summary_text}
                    </div>
                  </details>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
        <%!-- ── Right: controls ── --%>
        <div style="display:flex; flex-direction:column; gap:16px;">
          <%!-- Session schedule --%>
          <div style="border:1px solid #e2e8f0; border-radius:16px; padding:14px; background:#fafbfc;">
            <h3 style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:#94a3b8; margin-bottom:10px;">
              Horario de Sesión
            </h3>

            <.form for={%{}} id="schedule-form" phx-submit="save_session_schedule">
              <div style="margin-bottom:8px;">
                <label style="font-size:11px; font-weight:600; color:#475569; display:block; margin-bottom:4px;">
                  Día
                </label>
                <select
                  name="day"
                  style="width:100%; padding:6px 10px; border:1px solid #e2e8f0; border-radius:8px; font-size:13px; background:#fff; color:#334155;"
                >
                  <option value="1" selected={@selected_patient.session_day_of_week == 1}>
                    Lunes
                  </option>

                  <option value="2" selected={@selected_patient.session_day_of_week == 2}>
                    Martes
                  </option>

                  <option value="3" selected={@selected_patient.session_day_of_week == 3}>
                    Miércoles
                  </option>

                  <option value="4" selected={@selected_patient.session_day_of_week == 4}>
                    Jueves
                  </option>

                  <option value="5" selected={@selected_patient.session_day_of_week == 5}>
                    Viernes
                  </option>

                  <option value="6" selected={@selected_patient.session_day_of_week == 6}>
                    Sábado
                  </option>

                  <option value="7" selected={@selected_patient.session_day_of_week == 7}>
                    Domingo
                  </option>
                </select>
              </div>

              <div style="margin-bottom:10px;">
                <label style="font-size:11px; font-weight:600; color:#475569; display:block; margin-bottom:4px;">
                  Hora
                </label>
                <input
                  type="time"
                  name="time"
                  value={format_session_time(@selected_patient.session_time)}
                  style="width:100%; padding:6px 10px; border:1px solid #e2e8f0; border-radius:8px; font-size:13px; background:#fff; color:#334155;"
                />
              </div>

              <button
                type="submit"
                class="btn btn-primary"
                style="width:100%; font-size:12px; height:36px; border-radius:10px;"
              >
                Guardar cambios
              </button>
            </.form>
          </div>
          <%!-- Crisis containment message --%>
          <div style="border:1px solid rgba(245,158,11,.2); border-radius:16px; padding:14px; background:rgba(255,251,235,.5);">
            <div style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
              <.icon name="hero-megaphone" style="width:12px; height:12px; color:#f59e0b;" />
              <span style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:#f59e0b;">
                Mensaje de Contención
              </span>
            </div>

            <p style="font-size:10px; color:#94a3b8; line-height:1.4; margin-bottom:10px;">
              Enviado automáticamente en crisis detectada por la IA.
            </p>

            <.form for={%{}} id="crisis-message-form" phx-submit="save_crisis_message">
              <textarea
                name="crisis_message"
                rows="4"
                style="width:100%; padding:8px 10px; border:1px solid #e2e8f0; border-radius:8px; font-size:12px; line-height:1.5; resize:vertical; background:#fff; color:#334155; font-family:inherit;"
                placeholder="Ej: Entiendo que estás pasando por un momento difícil…"
              >{@current_professional.crisis_message}</textarea>
              <button
                type="submit"
                style="width:100%; margin-top:8px; padding:8px; border:1px solid rgba(245,158,11,.3); border-radius:10px; background:rgba(245,158,11,.08); color:#b45309; font-size:12px; font-weight:600; cursor:pointer;"
              >
                Actualizar
              </button>
            </.form>
          </div>
          <%!-- Custom welcome message --%>
          <div style="border:1px solid #e2e8f0; border-radius:16px; padding:14px; background:#fff;">
            <div style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
              <.icon
                name="hero-chat-bubble-left-right"
                style="width:12px; height:12px; color:#6366f1;"
              />
              <span style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:#6366f1;">
                Mensaje de Bienvenida
              </span>
            </div>

            <p style="font-size:10px; color:#94a3b8; line-height:1.4; margin-bottom:10px;">
              Enviado al vincular Telegram. Usá {"%{name}"} para incluir el nombre del paciente.
            </p>

            <.form for={%{}} id="welcome-message-form" phx-submit="save_welcome_message">
              <textarea
                name="welcome_message"
                rows="4"
                style="width:100%; padding:8px 10px; border:1px solid #e2e8f0; border-radius:8px; font-size:12px; line-height:1.5; resize:vertical; background:#fff; color:#334155; font-family:inherit;"
                placeholder="Ej: ¡Hola %{name}! Bienvenido a tu espacio…"
              >{@current_professional.welcome_message}</textarea>
              <button
                type="submit"
                style="width:100%; margin-top:8px; padding:8px; border:1px solid rgba(99,102,241,.3); border-radius:10px; background:rgba(99,102,241,.08); color:#4338ca; font-size:12px; font-weight:600; cursor:pointer;"
              >
                Actualizar
              </button>
            </.form>
          </div>
          <%!-- Decrypt chat button + history --%>
          <div style="border:1px solid #e2e8f0; border-radius:16px; padding:14px; background:#fff;">
            <h3 style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:#94a3b8; margin-bottom:10px;">
              Historial Clínico
            </h3>

            <button
              id="decrypt-chat-button"
              type="button"
              phx-click="decrypt_chat"
              class="btn"
              style={
                "width:100%; font-size:12px; height:36px; border-radius:10px; display:flex; align-items:center; justify-content:center; gap:6px;" <>
                if(@chat_decrypted,
                  do: "background:#f1f5f9; border:1px solid #e2e8f0; color:#64748b; cursor:default;",
                  else: "background:#6366f1; border:none; color:#fff;")
              }
            >
              <.icon
                name={if(@chat_decrypted, do: "hero-lock-open", else: "hero-lock-closed")}
                style="width:14px; height:14px;"
              /> {if @chat_decrypted, do: "Chat descifrado", else: "Descifrar chat"}
            </button>
             <%!-- Chat bubbles --%>
            <div
              :if={@chat_decrypted}
              id="chat-history-panel"
              phx-update="stream"
              style="margin-top:12px; max-height:300px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:12px; background:#fafbfc; padding:8px;"
            >
              <div
                :for={{id, msg} <- @streams.decrypted_messages}
                id={id}
                class={"chat " <> if(msg.direction == "inbound", do: "chat-start", else: "chat-end")}
              >
                <div class="chat-header" style="font-size:9px; color:#94a3b8; margin-bottom:2px;">
                  {Calendar.strftime(msg.timestamp, "%H:%M")}
                </div>

                <div
                  class={"chat-bubble " <> if(msg.direction == "outbound", do: "chat-bubble-primary", else: "")}
                  style="font-size:12px; line-height:1.5;"
                >
                  {msg.encrypted_content}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <%!-- Telegram invite modal (feature: patient telegram invites) --%>
    <div
      :if={@invite_modal}
      id="invite-modal"
      phx-click="close_invite_modal"
      phx-window-keydown="close_invite_modal"
      phx-key="escape"
      style="position:fixed; inset:0; background:rgba(15,23,42,.45); display:flex; align-items:center; justify-content:center; z-index:50; padding:20px;"
    >
      <div
        role="dialog"
        aria-modal="true"
        aria-label="Invitación a Telegram"
        phx-click-stop
        style="max-width:420px; width:100%; background:#fff; border-radius:16px; padding:20px; box-shadow:0 20px 40px rgba(15,23,42,.25);"
      >
        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:12px; margin-bottom:14px;">
          <div>
            <h3 style="font-size:14px; font-weight:700; color:#1e293b;">
              Invitar a <span id="invite-patient-alias">{@invite_modal.patient_alias}</span>
            </h3>

            <p style="font-size:11px; color:#94a3b8; margin-top:2px;">
              Compartí el enlace o el código con el paciente. Vencen en 10 minutos.
            </p>
          </div>

          <button
            id="invite-close"
            type="button"
            phx-click="close_invite_modal"
            aria-label="Cerrar"
            style="border:none; background:none; cursor:pointer; color:#94a3b8; padding:4px;"
          >
            <.icon name="hero-x-mark" style="width:16px; height:16px;" />
          </button>
        </div>

        <div :if={@invite_modal.deep_link} style="margin-bottom:12px;">
          <div style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#94a3b8; margin-bottom:4px;">
            Enlace
          </div>

          <a
            id="invite-deep-link"
            href={@invite_modal.deep_link}
            target="_blank"
            rel="noopener noreferrer"
            style="display:block; word-break:break-all; font-size:12px; color:#4338ca; font-weight:600; padding:8px 10px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px;"
          >
            {@invite_modal.deep_link}
          </a>
        </div>

        <div style="margin-bottom:12px;">
          <div style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#94a3b8; margin-bottom:4px;">
            Código de 6 dígitos
          </div>

          <div
            id="invite-six-digit"
            style="font-size:26px; font-weight:800; letter-spacing:0.18em; color:#1e293b; font-variant-numeric:tabular-nums; padding:10px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; text-align:center;"
          >
            {@invite_modal.six_digit_code}
          </div>
        </div>

        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;">
          <span style="font-size:11px; color:#94a3b8;">Vence a las</span>
          <span id="invite-expires-at" style="font-size:12px; font-weight:700; color:#475569;">
            {Calendar.strftime(@invite_modal.expires_at, "%H:%M")}
          </span>
        </div>

        <button
          id="invite-regenerate"
          type="button"
          phx-click="regenerate_invite"
          phx-value-id={@invite_modal.patient_id}
          class="btn"
          style="width:100%; font-size:12px; height:38px; border-radius:10px; background:#6366f1; border:none; color:#fff; font-weight:600; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:6px;"
        >
          <.icon name="hero-arrow-path" style="width:14px; height:14px;" /> Regenerar
        </button>
      </div>
    </div>
  </div>
</div>
